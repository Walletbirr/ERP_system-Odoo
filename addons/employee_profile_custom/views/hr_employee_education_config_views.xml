<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= EDUCATION LEVEL ================= -->
    <record id="view_hr_employee_education_level_list" model="ir.ui.view">
        <field name="name">hr.employee.education.level.list</field>
        <field name="model">hr.employee.education.level</field>
        <field name="arch" type="xml">
            <list string="Education Levels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_education_level_form" model="ir.ui.view">
        <field name="name">hr.employee.education.level.form</field>
        <field name="model">hr.employee.education.level</field>
        <field name="arch" type="xml">
            <form string="Education Level">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Bachelor's Degree"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_education_level" model="ir.actions.act_window">
        <field name="name">Education Levels</field>
        <field name="res_model">hr.employee.education.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new education level
            </p>
            <p>
                Used on the Educational Background tab of the Employee profile
                (e.g. High School, Diploma, Bachelor's Degree, Master's Degree, PhD).
            </p>
        </field>
    </record>

    <!-- ================= INSTITUTION ================= -->
    <record id="view_hr_employee_education_institution_list" model="ir.ui.view">
        <field name="name">hr.employee.education.institution.list</field>
        <field name="model">hr.employee.education.institution</field>
        <field name="arch" type="xml">
            <list string="Institutions" editable="bottom">
                <field name="name"/>
                <field name="country_id" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_education_institution_form" model="ir.ui.view">
        <field name="name">hr.employee.education.institution.form</field>
        <field name="model">hr.employee.education.institution</field>
        <field name="arch" type="xml">
            <form string="Institution">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Addis Ababa University"/>
                        <field name="country_id"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_education_institution" model="ir.actions.act_window">
        <field name="name">Institutions</field>
        <field name="res_model">hr.employee.education.institution</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new institution
            </p>
            <p>
                Universities, colleges and schools available on the
                Educational Background tab of the Employee profile.
            </p>
        </field>
    </record>

    <!-- ================= FIELD OF STUDY ================= -->
    <record id="view_hr_employee_education_field_list" model="ir.ui.view">
        <field name="name">hr.employee.education.field.list</field>
        <field name="model">hr.employee.education.field</field>
        <field name="arch" type="xml">
            <list string="Fields of Study" editable="bottom">
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_education_field_form" model="ir.ui.view">
        <field name="name">hr.employee.education.field.form</field>
        <field name="model">hr.employee.education.field</field>
        <field name="arch" type="xml">
            <form string="Field of Study">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Computer Science"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_education_field" model="ir.actions.act_window">
        <field name="name">Fields of Study</field>
        <field name="res_model">hr.employee.education.field</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new field of study
            </p>
            <p>
                Majors/fields of study available on the Educational Background
                tab of the Employee profile.
            </p>
        </field>
    </record>

    <!-- ================= DEGREE / QUALIFICATION ================= -->
    <record id="view_hr_employee_education_degree_list" model="ir.ui.view">
        <field name="name">hr.employee.education.degree.list</field>
        <field name="model">hr.employee.education.degree</field>
        <field name="arch" type="xml">
            <list string="Degrees / Qualifications" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_education_degree_form" model="ir.ui.view">
        <field name="name">hr.employee.education.degree.form</field>
        <field name="model">hr.employee.education.degree</field>
        <field name="arch" type="xml">
            <form string="Degree / Qualification">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. B.Sc."/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_employee_education_degree" model="ir.actions.act_window">
        <field name="name">Degrees / Qualifications</field>
        <field name="res_model">hr.employee.education.degree</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new degree / qualification
            </p>
            <p>
                Degrees/qualifications available on the Educational Background
                tab of the Employee profile (e.g. B.Sc., M.A., Diploma, Certificate).
            </p>
        </field>
    </record>

    <!-- ================= MENU (Employees > Configuration) ================= -->
    <!-- Grouped under one parent, same place core Odoo puts "Employee Tags",
         "Departure Reasons", etc. -->
    <menuitem id="menu_hr_employee_education_config"
              name="Educational Background"
              parent="hr.menu_human_resources_configuration"
              sequence="25"/>

    <menuitem id="menu_hr_employee_education_level"
              name="Education Levels"
              action="action_hr_employee_education_level"
              parent="menu_hr_employee_education_config"
              sequence="10"/>

    <menuitem id="menu_hr_employee_education_institution"
              name="Institutions"
              action="action_hr_employee_education_institution"
              parent="menu_hr_employee_education_config"
              sequence="20"/>

    <menuitem id="menu_hr_employee_education_field"
              name="Fields of Study"
              action="action_hr_employee_education_field"
              parent="menu_hr_employee_education_config"
              sequence="30"/>

    <menuitem id="menu_hr_employee_education_degree"
              name="Degrees / Qualifications"
              action="action_hr_employee_education_degree"
              parent="menu_hr_employee_education_config"
              sequence="40"/>

</odoo>
