<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_other_allowance_tree" model="ir.ui.view">
        <field name="name">hr.employee.other.allowance.tree</field>
        <field name="model">hr.employee.other.allowance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" string="Other Allowance"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="date_start" column_invisible="1"/>
                <field name="date_end" column_invisible="1"/>
                <field name="note" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_other_allowance_form" model="ir.ui.view">
        <field name="name">hr.employee.other.allowance.form</field>
        <field name="model">hr.employee.other.allowance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Other Allowance"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date_start" invisible="1"/>
                        <field name="date_end" invisible="1"/>
                        <field name="note" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
