<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        No binding_model_id — this deliberately does NOT show up in any
        record's own Print menu, since it isn't tied to one recordset. It's
        only ever triggered from the dashboard's Activity Log tab via its
        Export PDF button, which passes the active filters through the
        action context. See dashboard.js's exportActivityPdf and
        dashboard.py's _activity_report_values (wired up through
        BingetDashboardActivityReport, since Odoo's report engine only
        looks for _get_report_values on a model literally named
        "report.<report_name>" — see that class for why).
    -->
    <record id="action_report_activity_log" model="ir.actions.report">
        <field name="name">Activity Log</field>
        <field name="model">binget.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">binget_dashboard.activity_report_document</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="activity_report_document">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page binget_ar">
                    <style>
                        .binget_ar { font-family: 'Lato', 'Helvetica Neue', Arial, sans-serif; color: #2b2118; }
                        .binget_ar .ar_title_row {
                            display: flex; align-items: baseline; justify-content: space-between;
                            border-bottom: 3px solid #ba7517; padding-bottom: 10px; margin-bottom: 4px;
                        }
                        .binget_ar h1 {
                            font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0;
                            color: #2b2118;
                        }
                        .binget_ar .ar_company { font-size: 12px; color: #8a7f6e; font-weight: 600; }
                        .binget_ar .ar_meta_bar {
                            display: flex; flex-wrap: wrap; gap: 8px;
                            margin: 16px 0 20px; padding: 0;
                        }
                        .binget_ar .ar_chip {
                            background: #faf4e9; border: 1px solid #ecdfc4; border-radius: 20px;
                            padding: 5px 13px; font-size: 10.5px; color: #6b5f4d;
                        }
                        .binget_ar .ar_chip strong { color: #2b2118; font-weight: 700; }
                        .binget_ar table.ar_table {
                            width: 100%; border-collapse: collapse; font-size: 10.5px;
                            border: 1px solid #ecdfc4; border-radius: 8px; overflow: hidden;
                        }
                        .binget_ar table.ar_table thead { display: table-header-group; }
                        .binget_ar table.ar_table thead tr { background: #2b2118; }
                        .binget_ar table.ar_table thead th {
                            color: #f4ead6; font-weight: 700; text-transform: uppercase;
                            letter-spacing: 0.4px; font-size: 9px; text-align: left;
                            padding: 9px 10px; border: none;
                        }
                        .binget_ar table.ar_table thead th.ar_col_amount { text-align: right; }
                        .binget_ar table.ar_table tbody tr { page-break-inside: avoid; }
                        .binget_ar table.ar_table tbody tr:nth-child(even) { background: #faf6ee; }
                        .binget_ar table.ar_table tbody td {
                            padding: 7px 10px; border-bottom: 1px solid #f1e9d6; vertical-align: top;
                        }
                        .binget_ar table.ar_table tbody td.ar_col_amount {
                            text-align: right; font-weight: 700; font-variant-numeric: tabular-nums;
                        }
                        .binget_ar table.ar_table tbody td.ar_col_date { color: #8a7f6e; white-space: nowrap; }
                        .binget_ar table.ar_table tbody td.ar_col_user { color: #6b5f4d; }
                        .binget_ar .ar_empty { text-align: center; color: #8a7f6e; font-style: italic; padding: 26px !important; }
                        .binget_ar .ar_badge {
                            display: inline-block; padding: 2px 9px; border-radius: 20px;
                            font-size: 9px; font-weight: 700; color: #fff; white-space: nowrap;
                        }
                        .binget_ar .ar_footer_note {
                            margin-top: 18px; font-size: 9px; color: #a99c85; text-align: right;
                        }
                    </style>

                    <div class="ar_title_row">
                        <h1>Activity Log</h1>
                        <span class="ar_company" t-esc="company_name"/>
                    </div>

                    <div class="ar_meta_bar">
                        <span class="ar_chip">Type: <strong t-esc="type_label"/></span>
                        <span class="ar_chip">User: <strong t-esc="user_label"/></span>
                        <span class="ar_chip">Period: <strong><t t-esc="date_from or 'Any'"/> to <t t-esc="date_to or 'Any'"/></strong></span>
                        <span class="ar_chip" t-if="search">Search: <strong t-esc="search"/></span>
                        <span class="ar_chip">Total records: <strong t-esc="total"/></span>
                    </div>

                    <table class="ar_table">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Reference</th>
                                <th>Change</th>
                                <th>Partner</th>
                                <th class="ar_col_amount">Amount</th>
                                <th>User</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="not rows">
                                <td colspan="7" class="ar_empty">No activity matches these filters.</td>
                            </tr>
                            <tr t-foreach="rows" t-as="row">
                                <td>
                                    <span class="ar_badge"
                                          t-att-style="'background:' + {
                                              'Invoice': '#3d7ba8', 'Bill': '#8a5fb0', 'Sales Order': '#ba7517',
                                              'Purchase Order': '#2e8f8f', 'Transfer': '#4caf50',
                                              'Manufacturing Order': '#c9502e', 'Contact': '#6b6b6b', 'Product': '#d6961d',
                                          }.get(row['type'], '#6b6b6b')"
                                          t-esc="row['type']"/>
                                </td>
                                <td t-esc="row['label']"/>
                                <td t-esc="row.get('change')"/>
                                <td t-esc="row['partner']"/>
                                <td class="ar_col_amount" t-esc="'{:,.2f}'.format(row['amount']) if row['amount'] else '—'"/>
                                <td class="ar_col_user" t-esc="row['user']"/>
                                <td class="ar_col_date" t-esc="row['date'] and row['date'][:10]"/>
                            </tr>
                        </tbody>
                    </table>

                    <div class="ar_footer_note">
                        Generated by <span t-esc="generated_by"/> on <span t-esc="generated_at"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
