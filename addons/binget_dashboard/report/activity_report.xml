<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        No binding_model_id — this deliberately does NOT show up in any
        record's own Print menu, since it isn't tied to one recordset. It's
        only ever triggered from the dashboard's Activity Log tab via its
        Export PDF button, which passes the active filters through the
        action context. See dashboard.js's exportActivityPdf and
        dashboard.py's _get_report_values.
    -->
    <record id="action_report_activity_log" model="ir.actions.report">
        <field name="name">Activity Log</field>
        <field name="model">binget.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">binget_dashboard.activity_report_document</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="activity_report_document">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Activity Log</h2>
                    <table class="table table-sm" style="margin-bottom: 20px;">
                        <tr><td style="width: 160px;"><strong>Company</strong></td><td t-esc="company_name"/></tr>
                        <tr><td><strong>Type</strong></td><td t-esc="type_label"/></tr>
                        <tr><td><strong>User</strong></td><td t-esc="user_label"/></tr>
                        <tr>
                            <td><strong>Period</strong></td>
                            <td>
                                <t t-esc="date_from or 'Any'"/> to <t t-esc="date_to or 'Any'"/>
                            </td>
                        </tr>
                        <tr t-if="search"><td><strong>Search</strong></td><td t-esc="search"/></tr>
                        <tr><td><strong>Generated by</strong></td><td><span t-esc="generated_by"/> on <span t-esc="generated_at"/></td></tr>
                        <tr><td><strong>Total records</strong></td><td t-esc="total"/></tr>
                    </table>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Reference</th>
                                <th>Change</th>
                                <th>Partner</th>
                                <th>Amount</th>
                                <th>User</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-if="not rows">
                                <td colspan="7" class="text-center text-muted">No activity matches these filters.</td>
                            </tr>
                            <tr t-foreach="rows" t-as="row">
                                <td t-esc="row['type']"/>
                                <td t-esc="row['label']"/>
                                <td t-esc="row.get('change')"/>
                                <td t-esc="row['partner']"/>
                                <td t-esc="'{:,.2f}'.format(row['amount']) if row['amount'] else ''"/>
                                <td t-esc="row['user']"/>
                                <td t-esc="row['date'] and row['date'][:10]"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
