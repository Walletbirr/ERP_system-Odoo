<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_shell.TopNavbar">
        <nav class="o_theme_navbar">
            <div class="o_theme_navbar_brand" t-esc="companyName"/>

            <div class="o_theme_navbar_apps">
                <t t-foreach="state.apps" t-as="app" t-key="app.id">
                    <NavAppItem app="app"
                                isActive="app.id === state.currentAppId"
                                menuService="menuService"
                                onAppClick="onAppClick"/>
                </t>
            </div>

            <div class="o_theme_navbar_profile_wrapper">
                <div class="o_theme_navbar_profile" t-on-click="toggleProfileMenu">
                    <img t-if="userAvatarUrl" t-att-src="userAvatarUrl" class="o_theme_navbar_avatar"/>
                    <i t-else="" class="fa fa-user-circle o_theme_navbar_avatar_fallback"/>
                    <span class="o_theme_navbar_username" t-esc="userName"/>
                    <i class="fa fa-chevron-down o_theme_navbar_profile_caret"
                       t-att-class="{ 'o_theme_navbar_profile_caret_open': state.profileOpen }"/>
                </div>
                <div t-if="state.profileOpen" class="o_theme_navbar_profile_menu">
                    <a t-attf-href="/odoo/settings/users/{{userService.userId}}" class="o_theme_navbar_profile_menu_item">
                        <i class="fa fa-user"/> <span>Profile</span>
                    </a>
                    <a href="#" class="o_theme_navbar_profile_menu_item" t-on-click.prevent="logout">
                        <i class="fa fa-sign-out"/> <span>Log out</span>
                    </a>
                </div>
            </div>
        </nav>
    </t>

    <t t-name="theme_shell.NavAppItem">
        <div class="o_theme_navbar_app_wrapper" t-ref="root">
            <a href="#"
               class="o_theme_navbar_app"
               t-att-class="{ active: props.isActive, open: state.open }"
               t-on-click.prevent="onClick">
                <img t-if="props.app.webIconData" t-att-src="props.app.webIconData" class="o_theme_navbar_app_icon"/>
                <i t-else="" class="fa fa-th-large o_theme_navbar_app_icon"/>
                <span class="o_theme_navbar_app_label" t-esc="props.app.name"/>
                <i t-if="children.length" class="fa fa-chevron-down o_theme_navbar_app_chevron"
                   t-att-class="{ open: state.open }"/>
            </a>
        </div>
    </t>

    <t t-name="theme_shell.NavMenuItem">
        <div class="o_theme_navbar_menu_item_wrapper"
             t-att-class="{ 'has_children': hasChildren, 'flyout_open': state.open }"
             t-ref="root">
            <a href="#" class="o_theme_navbar_menu_item" t-on-click.prevent="onClick">
                <span t-esc="props.item.name"/>
                <i t-if="hasChildren" class="fa fa-chevron-right o_theme_navbar_flyout_caret"
                   t-att-class="{ open: state.open }"/>
            </a>
        </div>
    </t>

    <t t-name="theme_shell.NavFlyoutPanel">
        <div class="o_theme_navbar_flyout_panel">
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <NavMenuItem item="item" onLeafClick="props.onLeafClick"/>
            </t>
        </div>
    </t>

</templates>
