<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_shell.Sidebar">
        <nav class="o_theme_sidebar" t-att-class="{ 'o_theme_sidebar_collapsed': state.collapsed }">

            <!-- Sticky header: does NOT live inside the scrollable area below -->
            <div class="o_theme_sidebar_header">
                <div class="o_theme_sidebar_brand_wrap">
                    <div class="o_theme_sidebar_brand">
                        <span class="o_theme_sidebar_brand_main" t-esc="brandName.main"/>
                    </div>
                </div>
                <div class="o_theme_sidebar_header_actions">
                    <div class="o_theme_sidebar_notif_wrap" t-ref="notifWrap">
                        <button class="o_theme_sidebar_notif_btn" t-on-click="toggleNotifications" title="Notifications">
                            <i class="fa fa-bell-o"/>
                            <span t-if="notificationBadgeCount" class="o_theme_sidebar_notif_badge" t-esc="notificationBadgeCount"/>
                        </button>
                        <div t-if="state.showNotifications" class="o_theme_sidebar_notif_panel">
                            <div class="o_theme_sidebar_notif_panel_header">
                                <span>Notifications</span>
                                <span t-if="visibleNotifications.some((r) => r.is_new)"
                                      class="o_theme_sidebar_notif_mark_seen"
                                      t-on-click="markNotificationsSeen">Mark all as seen</span>
                            </div>
                            <div t-if="!visibleNotifications.length" class="o_theme_sidebar_notif_empty">You're all caught up.</div>
                            <t t-foreach="visibleNotifications" t-as="n" t-key="n.id">
                                <div t-att-class="'o_theme_sidebar_notif_row severity_' + n.severity + (n.is_new ? ' is_new' : '')"
                                     t-on-click="() => this.onNotificationClick(n)">
                                    <i t-att-class="n.severity === 'critical' ? 'fa fa-exclamation-circle' : (n.severity === 'warning' ? 'fa fa-exclamation-triangle' : 'fa fa-info-circle')"/>
                                    <div class="o_theme_sidebar_notif_body">
                                        <div class="o_theme_sidebar_notif_title" t-esc="n.title"/>
                                        <div class="o_theme_sidebar_notif_desc" t-esc="n.description"/>
                                        <div t-if="n.notif_type === 'request'" class="o_theme_sidebar_notif_persist_hint">Stays until you resolve it — seeing it just clears your count</div>
                                    </div>
                                    <i t-if="n.is_new" class="fa fa-check o_theme_sidebar_notif_dismiss" title="Mark as seen"
                                       t-on-click="(ev) => this.markNotificationSeen(n, ev)"/>
                                    <span t-else="" class="o_theme_sidebar_notif_spacer"/>
                                </div>
                            </t>
                        </div>
                    </div>
                    <button class="o_theme_sidebar_theme_toggle"
                            t-on-click="toggleTheme"
                            t-att-title="state.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme'">
                        <i t-att-class="state.theme === 'light' ? 'fa fa-moon-o' : 'fa fa-sun-o'"/>
                    </button>
                    <button class="o_theme_sidebar_toggle" t-on-click="toggleCollapsed">
                        <i class="fa fa-bars"/>
                    </button>
                </div>
            </div>

            <!-- Search: not shown when collapsed (no room for it at 68px) -->
            <div class="o_theme_sidebar_search">
                <i class="fa fa-search o_theme_sidebar_search_icon"/>
                <input type="text"
                       t-ref="searchInput"
                       class="o_theme_sidebar_search_input"
                       placeholder="Search..."
                       t-att-value="state.searchQuery"
                       t-on-input="onSearchInput"
                       t-on-keydown="onSearchKeydown"/>
                <i t-if="state.searchQuery"
                   class="fa fa-times-circle o_theme_sidebar_search_clear"
                   t-on-click="() => { state.searchQuery = ''; state.highlightedIndex = -1; }"/>
            </div>

            <!-- Only this scrolls: either the normal app list, or search results -->
            <div class="o_theme_sidebar_apps">

                <t t-if="state.searchQuery.trim().length">
                    <div t-if="!searchResults.length" class="o_theme_sidebar_search_empty">
                        No matches for "<t t-esc="state.searchQuery"/>"
                    </div>
                    <t t-foreach="searchResults" t-as="result" t-key="result.id">
                        <a t-att-href="getSearchResultHref(result)"
                           class="o_theme_sidebar_search_result"
                           t-att-class="{ 'highlighted': result_index === state.highlightedIndex }"
                           t-on-click.prevent="() => this.onSearchResultClick(result)">
                            <span class="o_theme_sidebar_search_result_name" t-esc="result.name"/>
                            <span t-if="!result.isApp" class="o_theme_sidebar_search_result_path" t-esc="result.path"/>
                        </a>
                    </t>
                </t>

                <t t-else="">
                    <t t-foreach="state.apps" t-as="app" t-key="app.id">
                        <div class="o_theme_sidebar_app_group">
                            <a t-att-href="getMenuHref(app)"
                               class="o_theme_sidebar_app"
                               t-att-class="{ 'active': app.id === state.currentAppId }"
                               t-att-title="state.collapsed ? app.name : ''"
                               t-on-click.prevent="() => this.onClickApp(app)">
                                <span class="o_theme_sidebar_app_icon_wrap">
                                    <img t-if="app.webIconData" t-att-src="app.webIconData" class="o_theme_sidebar_app_icon"/>
                                    <i t-else="" class="fa fa-th-large o_theme_sidebar_app_icon"/>
                                </span>
                                <span class="o_theme_sidebar_app_label" t-esc="app.name"/>
                                <i class="fa fa-chevron-down o_theme_sidebar_chevron"
                                   t-att-class="{ 'o_theme_sidebar_chevron_open': app.id === state.expandedAppId }"/>
                            </a>

                            <div t-if="app.id === state.expandedAppId and state.currentAppSubmenus.length"
                                 class="o_theme_sidebar_submenus">
                                <t t-foreach="state.currentAppSubmenus" t-as="item" t-key="item.id">
                                    <SidebarMenuItem item="item" onLeafClick="onLeafClick" sidebarState="state"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </div>

            <!-- Sticky footer: profile / logout -->
            <div class="o_theme_sidebar_footer" t-ref="profileContainer">
                <div t-if="state.profileOpen" class="o_theme_sidebar_profile_menu">
                    <a href="#" class="o_theme_sidebar_profile_menu_item" t-on-click.prevent="openProfile">
                        <i class="fa fa-user"/> <span>Profile</span>
                    </a>
                    <a href="#" class="o_theme_sidebar_profile_menu_item" t-on-click.prevent="logout">
                        <i class="fa fa-sign-out"/> <span>Log out</span>
                    </a>
                </div>
                <div class="o_theme_sidebar_profile" t-on-click="toggleProfileMenu">
                    <img t-if="userAvatarUrl" t-att-src="userAvatarUrl" class="o_theme_sidebar_avatar"/>
                    <i t-else="" class="fa fa-user-circle o_theme_sidebar_avatar_fallback"/>
                    <span class="o_theme_sidebar_username" t-esc="userName"/>
                    <i class="fa fa-chevron-up o_theme_sidebar_profile_caret"
                       t-att-class="{ 'o_theme_sidebar_profile_caret_open': state.profileOpen }"/>
                </div>
            </div>
        </nav>
    </t>

    <t t-name="theme_shell.SidebarMenuItem">
        <div class="o_theme_sidebar_menu_item_wrapper"
             t-att-class="{ 'has_children': hasChildren }"
             t-ref="root">
            <a t-att-href="href" class="o_theme_sidebar_submenu_item" t-att-class="{ 'active': isActive }" t-on-click.prevent="onClick">
                <span t-esc="props.item.name"/>
                <i t-if="hasChildren" class="fa fa-chevron-right o_theme_sidebar_flyout_caret"/>
            </a>
        </div>
    </t>

    <!--
        This is what actually renders inside the popover, i.e. portalled
        out of the sidebar's scrollable DOM entirely. Click-driven (see
        SidebarMenuItem.onClick in sidebar.js) rather than hover-driven,
        so there's no timer/mouseenter/mouseleave wiring needed here.
    -->
    <t t-name="theme_shell.SidebarFlyoutPanel">
        <div class="o_theme_sidebar_flyout_panel">
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <SidebarMenuItem item="item" onLeafClick="props.onLeafClick" sidebarState="props.sidebarState"/>
            </t>
        </div>
    </t>

</templates>
