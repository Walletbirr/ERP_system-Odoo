<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_retained_earnings_config_form" model="ir.ui.view">
        <field name="name">account.retained.earnings.config.form</field>
        <field name="model">account.retained.earnings.config</field>
        <field name="arch" type="xml">
            <form string="Retained Earnings Setup">
                <p class="text-muted">
                    Choose where each year's profit or loss is posted when you close the fiscal year.
                </p>
                <group>
                    <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    <field name="retained_earnings_account_id"/>
                    <field name="closing_journal_id"/>
                </group>
                <footer>
                    <button name="action_save" string="Save" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_retained_earnings_config" model="ir.actions.act_window">
        <field name="name">Retained Earnings Setup</field>
        <field name="res_model">account.retained.earnings.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
