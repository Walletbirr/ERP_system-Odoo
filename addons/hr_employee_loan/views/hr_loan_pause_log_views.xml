<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_loan_pause_log_view_list" model="ir.ui.view">
        <field name="name">hr.loan.pause.log.list</field>
        <field name="model">hr.loan.pause.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="is_open">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="loan_id"/>
                <field name="scope"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="reason"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="skipped_count" sum="Total"/>
                <field name="is_open" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="hr_loan_pause_log_view_search" model="ir.ui.view">
        <field name="name">hr.loan.pause.log.search</field>
        <field name="model">hr.loan.pause.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="loan_id"/>
                <field name="reason"/>
                <filter name="open" string="Still On Hold" domain="[('date_end', '=', False)]"/>
                <filter name="closed" string="Resumed" domain="[('date_end', '!=', False)]"/>
                <separator/>
                <filter name="scope_loan" string="This Loan Only" domain="[('scope', '=', 'loan')]"/>
                <filter name="scope_all" string="All Loans" domain="[('scope', '=', 'all')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_loan" string="Loan" context="{'group_by': 'loan_id'}"/>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope'}"/>
                    <filter name="group_month" string="Paused Month" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_loan_pause_log" model="ir.actions.act_window">
        <field name="name">Pause History</field>
        <field name="res_model">hr.loan.pause.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="hr_loan_pause_log_view_search"/>
    </record>

</odoo>
