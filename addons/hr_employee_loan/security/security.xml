<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_hr_loan" model="ir.module.category">
        <field name="name">Employee Loans</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_loan_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_hr_loan"/>
        <field name="comment">Can see all loans and prepare draft loans.</field>
    </record>

    <record id="group_loan_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hr_loan"/>
        <field name="implied_ids" eval="[(4, ref('group_loan_user'))]"/>
        <field name="comment">Can confirm / cancel loans, pause or skip deductions and mark installments paid.</field>
    </record>

    <!-- HR officers prepare loans, HR managers and accountants run them -->
    <record id="hr.group_hr_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_employee_loan.group_loan_user'))]"/>
    </record>
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_employee_loan.group_loan_manager'))]"/>
    </record>
    <record id="account.group_account_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_employee_loan.group_loan_manager'))]"/>
    </record>

    <!-- Record rules -->
    <record id="hr_loan_rule_multi_company" model="ir.rule">
        <field name="name">Employee Loan: multi-company</field>
        <field name="model_id" ref="model_hr_loan"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="hr_loan_line_rule_multi_company" model="ir.rule">
        <field name="name">Loan Installment: multi-company</field>
        <field name="model_id" ref="model_hr_loan_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hr_loan_rule_own" model="ir.rule">
        <field name="name">Employee Loan: employee sees own loans</field>
        <field name="model_id" ref="model_hr_loan"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="hr_loan_line_rule_own" model="ir.rule">
        <field name="name">Loan Installment: employee sees own</field>
        <field name="model_id" ref="model_hr_loan_line"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="hr_loan_rule_officer" model="ir.rule">
        <field name="name">Employee Loan: officers see all</field>
        <field name="model_id" ref="model_hr_loan"/>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="hr_loan_line_rule_officer" model="ir.rule">
        <field name="name">Loan Installment: officers see all</field>
        <field name="model_id" ref="model_hr_loan_line"/>
        <field name="groups" eval="[(4, ref('group_loan_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
