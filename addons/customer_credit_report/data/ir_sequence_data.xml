<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_customer_credit_request" model="ir.sequence">
            <field name="name">Credit Sales Report</field>
            <field name="code">customer.credit.request</field>
            <field name="prefix">CSR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_customer_credit_payment" model="ir.sequence">
            <field name="name">Credit Payment</field>
            <field name="code">customer.credit.payment</field>
            <field name="prefix">CPAY/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
