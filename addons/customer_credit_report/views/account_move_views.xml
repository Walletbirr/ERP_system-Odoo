<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_out_invoice_tree_customer_credit" model="ir.ui.view">
        <field name="name">account.move.out.list.customer.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_sale_type" string="Sales Type" optional="show" widget="badge"
                       decoration-warning="x_sale_type == 'credit'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_customer_credit" model="ir.ui.view">
        <field name="name">account.move.search.customer.credit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Credit Sales" name="credit_sales"
                        domain="[('x_sale_type', '=', 'credit')]"/>
                <filter string="Cash Sales" name="cash_sales"
                        domain="[('x_sale_type', '=', 'cash')]"/>
            </xpath>
        </field>
    </record>

</odoo>
