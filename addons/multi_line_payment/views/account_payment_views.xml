<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_multi_line" model="ir.ui.view">
        <field name="name">account.payment.form.multi.line</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <!-- Longer voucher names: stack the radio buttons -->
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="options">{'horizontal': False}</attribute>
            </xpath>

            <!-- Checkbox to switch the multi line mode on -->
            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="is_multi_line"
                       readonly="state != 'draft'"
                       invisible="payment_type not in ('inbound', 'outbound')"/>
            </xpath>

            <!-- The amount is the sum of the lines (kept on save with force_save) -->
            <xpath expr="//div[@name='amount_div']/field[@name='amount']" position="attributes">
                <attribute name="readonly">state != 'draft' or is_multi_line</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <!-- Memo becomes "Purpose", shown under the bank account fields -->
            <xpath expr="//field[@name='memo']" position="attributes">
                <attribute name="string">Purpose</attribute>
            </xpath>
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="memo" position="move"/>
            </xpath>

            <!-- Payment lines tab -->
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page name="multi_lines" string="Payment Lines" invisible="not is_multi_line">
                    <field name="multi_line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
