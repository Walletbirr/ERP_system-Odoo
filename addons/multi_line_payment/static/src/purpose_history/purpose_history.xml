<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="multi_line_payment.PurposeHistoryField">
        <t t-if="props.readonly">
            <span t-esc="props.record.data[props.name] || ''"/>
        </t>
        <t t-else="">
            <div class="o_purpose_history position-relative w-100" t-ref="wrapper"
                 t-on-focusin="onFocusIn" t-on-focusout="onFocusOut"
                 t-on-keydown="onKeydown">
                <input class="o_input" type="text" autocomplete="off"
                       t-att-id="props.id" t-att-placeholder="props.placeholder"
                       t-ref="input" t-on-input="onInput"/>
                <div t-if="historyState.open and (filteredItems.length or historyState.items.length)"
                     class="o_purpose_history_panel" tabindex="-1">
                    <div class="o_purpose_history_header">
                        <span><i class="fa fa-history me-1"/>Recent purposes</span>
                        <button type="button" class="o_purpose_history_clear"
                                t-on-mousedown.prevent=""
                                t-on-click="onClearAll">Clear all</button>
                    </div>
                    <div t-if="!filteredItems.length" class="o_purpose_history_empty">
                        No match in your history
                    </div>
                    <ul class="o_purpose_history_list">
                        <li t-foreach="filteredItems" t-as="item" t-key="item.id"
                            class="o_purpose_history_item">
                            <button type="button" class="o_purpose_history_text"
                                    t-on-mousedown.prevent=""
                                    t-on-click="() => this.onSelect(item)">
                                <t t-esc="item.name"/>
                            </button>
                            <button type="button" class="o_purpose_history_remove"
                                    title="Remove from history"
                                    t-on-mousedown.prevent=""
                                    t-on-click="() => this.onRemove(item)">
                                <i class="fa fa-times"/>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </t>
    </t>

</templates>
