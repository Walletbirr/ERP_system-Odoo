<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_validate_confirm_form" model="ir.ui.view">
        <field name="name">stock.picking.validate.confirm.form</field>
        <field name="model">stock.picking.validate.confirm</field>
        <field name="arch" type="xml">
            <form string="Confirm Validation">
                <field name="picking_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <strong>Are you sure you want to validate this transfer?</strong>
                </div>
                <group>
                    <field name="picking_names" string="Transfer(s)" readonly="1"/>
                    <field name="operation_type_names" string="Operation Type" readonly="1"/>
                </group>
                <p>
                    This will confirm the quantities and update stock levels.
                    This action cannot be easily undone - please make sure the
                    quantities and products are correct before continuing.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Yes, Validate"
                            class="btn-primary"/>
                    <button name="action_cancel" type="object" string="No, Go Back"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
