<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The Service Charge product (defined in custom_invoice_management)
         must be invoiced on ORDERED quantity so the Service Charge line is
         invoiced together with the product line it balances. -->
    <record id="custom_invoice_management.product_service_charge" model="product.product">
        <field name="invoice_policy">order</field>
        <field name="sale_ok" eval="True"/>
    </record>
</odoo>
