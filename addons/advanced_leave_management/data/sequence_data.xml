<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_leave_request" model="ir.sequence">
        <field name="name">Leave Request</field>
        <field name="code">leave.request</field>
        <field name="prefix">LR/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_leave_encashment" model="ir.sequence">
        <field name="name">Leave Encashment</field>
        <field name="code">leave.encashment</field>
        <field name="prefix">LE/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
