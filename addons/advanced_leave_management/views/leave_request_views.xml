<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_request_form" model="ir.ui.view">
        <field name="name">leave.request.form</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_hr_confirm" type="object" string="HR Confirm (No Approval Needed)"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="advanced_leave_management.group_leave_hr_officer"/>
                    <button name="action_submit" type="object" string="Submit for Approval"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="advanced_leave_management.group_leave_self_service"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="advanced_leave_management.group_leave_officer"/>
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state != 'submitted'"
                            groups="advanced_leave_management.group_leave_officer"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'approved'"
                            confirm="Cancelling will reverse the balance deduction. Continue?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type_id"/>
                            <field name="origin" invisible="1"/>
                            <field name="request_unit" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="duration_days"/>
                            <field name="current_balance_display" string="Available Balance"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="attachment_ids" widget="many2many_binary"
                               string="Supporting Documents"/>
                    </group>
                    <group invisible="state != 'refused'">
                        <field name="refusal_reason"/>
                    </group>
                    <group string="Approval Info" invisible="state not in ('approved', 'refused')">
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_leave_request_tree" model="ir.ui.view">
        <field name="name">leave.request.tree</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'refused'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="duration_days"/>
                <field name="origin"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_leave_request_calendar" model="ir.ui.view">
        <field name="name">leave.request.calendar</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" mode="month"
                      color="leave_type_id" quick_create="0">
                <field name="employee_id"/>
                <field name="leave_type_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_leave_request_search" model="ir.ui.view">
        <field name="name">leave.request.search</field>
        <field name="model">leave.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id','=',uid)]"/>
                <filter string="Pending Approval" name="pending" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <separator/>
                <filter string="HR Entered" name="hr_entry" domain="[('origin','=','hr_entry')]"/>
                <filter string="Self-Service" name="self_service" domain="[('origin','=','self_service')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Leave Type" name="group_type" context="{'group_by':'leave_type_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_leave_request_all" model="ir.actions.act_window">
        <field name="name">All Leave Requests</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_pending': 0}</field>
    </record>

    <record id="action_leave_request_approvals" model="ir.actions.act_window">
        <field name="name">Approvals Inbox</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
        <field name="context">{}</field>
    </record>

    <record id="action_leave_request_my" model="ir.actions.act_window">
        <field name="name">My Leave Requests</field>
        <field name="res_model">leave.request</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_employee_id': uid}</field>
    </record>
</odoo>
