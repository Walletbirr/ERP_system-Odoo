<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_opening_balance_import_form" model="ir.ui.view">
        <field name="name">leave.opening.balance.import.form</field>
        <field name="model">leave.opening.balance.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="result_log" invisible="1"/>
                <group invisible="result_log">
                    <field name="leave_type_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="default_effective_date"/>
                    <field name="default_reason"/>
                </group>
                <div invisible="not result_log">
                    <h3>Import Result</h3>
                    <field name="result_log" widget="text" readonly="1"/>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="result_log"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leave_opening_balance_import" model="ir.actions.act_window">
        <field name="name">Import Opening Balances</field>
        <field name="res_model">leave.opening.balance.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
