<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_allocation_form" model="ir.ui.view">
        <field name="name">leave.allocation.form</field>
        <field name="model">leave.allocation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="leave_type_id"/>
                        </group>
                        <group>
                            <field name="current_balance"/>
                            <field name="last_accrual_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ledger">
                            <field name="ledger_line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="date"/>
                                    <field name="move_type"/>
                                    <field name="amount"/>
                                    <field name="reason"/>
                                    <field name="request_id"/>
                                    <field name="create_uid_display"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_leave_allocation_tree" model="ir.ui.view">
        <field name="name">leave.allocation.tree</field>
        <field name="model">leave.allocation</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="leave_type_id"/>
                <field name="current_balance"/>
                <field name="last_accrual_date"/>
            </list>
        </field>
    </record>

    <record id="action_leave_allocation" model="ir.actions.act_window">
        <field name="name">Leave Balances</field>
        <field name="res_model">leave.allocation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
