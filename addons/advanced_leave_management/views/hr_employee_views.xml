<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_leave_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.leave.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_leave_balances" type="object"
                        class="oe_stat_button" icon="fa-calendar">
                    <field name="leave_allocation_count" widget="statinfo" string="Leave Balances"/>
                </button>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Leave Accrual" name="leave_accrual">
                    <field name="leave_contract_start_date"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
