<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_summary_report_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.summary.report.form</field>
        <field name="model">hr.payslip.summary.report</field>
        <field name="arch" type="xml">
            <form string="Payroll Summary Report">
                <group>
                    <group>
                        <field name="batch_ids" widget="many2many_tags" />
                        <field name="employee_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="include_non_confirmed" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Print PDF"
                        name="action_print_pdf"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Export Excel"
                        name="action_export_xlsx"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_payslip_summary_report_action" model="ir.actions.act_window">
        <field name="name">Payroll Summary Report</field>
        <field name="res_model">hr.payslip.summary.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="hr_payslip_summary_report_menu"
        name="Payroll Summary Report"
        action="hr_payslip_summary_report_action"
        parent="payroll.payroll_menu_root"
        sequence="60"
        groups="payroll.group_payroll_user"
    />
</odoo>
