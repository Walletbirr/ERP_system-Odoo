<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        CUSTOMER INVOICE PDF (sales invoice design).

        How it is plugged in: account.move._get_name_invoice_report()
        (models/account_move.py) returns this template for customer
        invoices / credit notes, and the dispatcher account.report_invoice
        gets one extra branch (below) that calls it. Print, Send & Print,
        the e-mail attachment and the portal all go through that dispatcher.

        Header (logo + title) and footer (note + page number) come from the
        company layout, exactly like the quotation, so nothing there changes.
        This template only draws the BODY: seller/buyer cards, an info strip,
        the product lines (NO Other Income line) and the full price
        breakdown, with the same figures as the Sales Order.
        Tables are used on purpose: wkhtmltopdf renders them reliably.
    -->
    <template id="report_invoice_dispatch_bridge" inherit_id="account.report_invoice">
        <xpath expr="//t[@t-call='account.report_invoice_document']" position="after">
            <t t-elif="o._get_name_invoice_report() == 'accounting_so_invoice_bridge.report_invoice_document_sales'"
               t-call="accounting_so_invoice_bridge.report_invoice_document_sales"
               t-lang="lang"/>
        </xpath>
    </template>

    <!-- Seller / Buyer card. Variables: party (res.partner), card_title -->
    <template id="report_party_card">
        <table style="width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid #E2D8C6; border-radius: 6px; font-size: 10px;">
            <thead>
                <tr>
                    <th colspan="2"
                        t-attf-style="background: #{brand}; color: #ffffff; padding: 5px 10px; font-size: 9.5px; letter-spacing: 1.2px; text-transform: uppercase; text-align: left; border-radius: 5px 5px 0 0;">
                        <t t-out="card_title"/>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="2" style="padding: 7px 10px 4px 10px; font-size: 12px; font-weight: bold; color: #1d1d1d;">
                        <t t-out="party.commercial_partner_id.name or party.name"/>
                    </td>
                </tr>
                <tr t-if="party.street or party.street2">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170; width: 28%;">Address</td>
                    <td style="padding: 2px 10px 2px 0;">
                        <t t-out="party.street"/><t t-if="party.street2">, <t t-out="party.street2"/></t>
                    </td>
                </tr>
                <tr t-if="party.city">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170;">City</td>
                    <td style="padding: 2px 10px 2px 0;"><t t-out="party.city"/></td>
                </tr>
                <tr t-if="party.state_id">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170;">State / Zone</td>
                    <td style="padding: 2px 10px 2px 0;"><t t-out="party.state_id.name"/></td>
                </tr>
                <tr t-if="party.country_id">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170;">Country</td>
                    <td style="padding: 2px 10px 2px 0;"><t t-out="party.country_id.name"/></td>
                </tr>
                <tr t-if="party.phone">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170;">Phone</td>
                    <td style="padding: 2px 10px 2px 0;"><t t-out="party.phone"/></td>
                </tr>
                <tr t-if="party.email">
                    <td style="padding: 2px 4px 2px 10px; color: #8a8170;">Email</td>
                    <td style="padding: 2px 10px 2px 0;"><t t-out="party.email"/></td>
                </tr>
                <tr>
                    <td style="padding: 2px 4px 7px 10px; color: #8a8170;">Tax ID (TIN)</td>
                    <td style="padding: 2px 10px 7px 0; font-weight: bold;"><t t-out="party.vat or '-'"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <!-- One cell of the info strip. Variables: info_label and either
         info_date (a date) or info_value (text) -->
    <template id="report_info_cell">
        <td style="padding: 6px 10px; vertical-align: top; border-right: 1px solid #E2D8C6;">
            <div style="font-size: 8.5px; letter-spacing: 1px; text-transform: uppercase; color: #8a8170;"><t t-out="info_label"/></div>
            <div style="font-size: 10.5px; font-weight: bold; color: #1d1d1d; margin-top: 2px;">
                <span t-if="info_date" t-out="info_date" t-options='{"widget": "date"}'/>
                <t t-else="" t-out="info_value or '-'"/>
            </div>
        </td>
    </template>

    <!-- One row of the price breakdown. Variables: row_label, row_value -->
    <template id="report_total_row">
        <tr>
            <td style="padding: 4px 10px; color: #4a4435; border-bottom: 1px solid #EFE8DA;"><t t-out="row_label"/></td>
            <td style="padding: 4px 10px; text-align: right; border-bottom: 1px solid #EFE8DA; white-space: nowrap;"><span t-out="row_value" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
        </tr>
    </template>

    <template id="report_invoice_document_sales">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <!-- no single address box in the header: the cards below replace it -->
            <t t-set="address"/>
            <t t-set="brand" t-value="o.company_id.primary_color or '#7A4E00'"/>
            <t t-set="seller" t-value="o.company_id.partner_id"/>
            <t t-set="buyer" t-value="o.partner_id"/>
            <t t-set="order" t-value="o.x_sale_order_ids[:1]"/>

            <div class="page" style="font-size: 10.5px; color: #222;">

                <!-- ===== Seller / Buyer ===== -->
                <table style="width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 10px;">
                    <tr>
                        <td style="width: 49%; vertical-align: top; padding: 0;">
                            <t t-call="accounting_so_invoice_bridge.report_party_card">
                                <t t-set="party" t-value="seller"/>
                                <t t-set="card_title">Seller (From)</t>
                            </t>
                        </td>
                        <td style="width: 2%; padding: 0;"/>
                        <td style="width: 49%; vertical-align: top; padding: 0;">
                            <t t-call="accounting_so_invoice_bridge.report_party_card">
                                <t t-set="party" t-value="buyer"/>
                                <t t-set="card_title">Buyer (To)</t>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- ===== Info strip ===== -->
                <table style="width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid #E2D8C6; border-radius: 6px; background: #F8F4EC; margin-bottom: 14px;">
                    <tr>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Invoice Date</t>
                            <t t-set="info_date" t-value="o.invoice_date"/>
                        </t>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Due Date</t>
                            <t t-set="info_date" t-value="o.invoice_date_due"/>
                        </t>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Delivery Date</t>
                            <t t-set="info_date" t-value="o._bridge_delivery_date()"/>
                        </t>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Order Ref.</t>
                            <t t-set="info_date" t-value="False"/>
                            <t t-set="info_value" t-value="o.invoice_origin or '-'"/>
                        </t>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Salesperson</t>
                            <t t-set="info_date" t-value="False"/>
                            <t t-set="info_value" t-value="o.invoice_user_id.name or '-'"/>
                        </t>
                        <t t-call="accounting_so_invoice_bridge.report_info_cell">
                            <t t-set="info_label">Branch</t>
                            <t t-set="info_date" t-value="False"/>
                            <t t-set="info_value" t-value="order.x_sale_branch_id.name or '-'"/>
                        </t>
                    </tr>
                </table>

                <!-- ===== Product lines (Other Income is NOT listed) ===== -->
                <table style="width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid #E2D8C6; border-radius: 6px; margin-bottom: 14px;">
                    <thead style="display: table-header-group;">
                        <tr t-attf-style="background: #{brand}; color: #ffffff; font-size: 9px; letter-spacing: 1px; text-transform: uppercase;">
                            <th style="padding: 7px 8px; width: 5%; text-align: center; border-radius: 5px 0 0 0;">#</th>
                            <th style="padding: 7px 8px; text-align: left;">Description</th>
                            <th style="padding: 7px 8px; width: 11%; text-align: right;">Quantity</th>
                            <th style="padding: 7px 8px; width: 15%; text-align: right;">Unit Price</th>
                            <th style="padding: 7px 8px; width: 14%; text-align: left;">Taxes</th>
                            <th style="padding: 7px 8px; width: 17%; text-align: right; border-radius: 0 5px 0 0;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.x_sales_line_ids" t-as="line">
                            <tr t-attf-style="page-break-inside: avoid; background: #{'#FBF9F4' if line_index % 2 else '#ffffff'};">
                                <td style="padding: 7px 8px; text-align: center; color: #8a8170; border-bottom: 1px solid #EFE8DA;"><t t-out="line_index + 1"/></td>
                                <td style="padding: 7px 8px; border-bottom: 1px solid #EFE8DA; white-space: pre-line;"><t t-out="line.name"/></td>
                                <td style="padding: 7px 8px; text-align: right; border-bottom: 1px solid #EFE8DA; white-space: nowrap;">
                                    <span t-field="line.quantity"/>
                                    <span t-if="line.product_uom_id" style="color: #8a8170;" t-out="line.product_uom_id.name"/>
                                </td>
                                <td style="padding: 7px 8px; text-align: right; border-bottom: 1px solid #EFE8DA; white-space: nowrap;"><span t-field="line.price_unit"/></td>
                                <td style="padding: 7px 8px; border-bottom: 1px solid #EFE8DA;">
                                    <t t-out="', '.join(line.tax_ids.mapped('name')) or '-'"/>
                                </td>
                                <td style="padding: 7px 8px; text-align: right; font-weight: bold; border-bottom: 1px solid #EFE8DA; white-space: nowrap;"><span t-field="line.price_subtotal"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- ===== Notes (left) + full price breakdown (right) ===== -->
                <table style="width: 100%; border-collapse: separate; border-spacing: 0; page-break-inside: avoid;">
                    <tr>
                        <td style="width: 52%; vertical-align: top; padding: 0 16px 0 0; font-size: 10px;">
                            <div style="margin-bottom: 8px;">
                                <span style="color: #8a8170;">Payment Communication:</span>
                                <strong t-out="o.payment_reference or o.name"/>
                            </div>
                            <div t-if="o._bridge_amount_in_words()" style="margin-bottom: 8px;">
                                <div style="color: #8a8170;">Amount in words</div>
                                <div style="font-weight: bold;" t-out="o._bridge_amount_in_words()"/>
                            </div>
                            <div t-if="o.narration" style="margin-top: 8px;">
                                <div style="color: #8a8170;">Terms and conditions</div>
                                <div style="white-space: pre-line;" t-out="o.narration"/>
                            </div>
                        </td>
                        <td style="width: 48%; vertical-align: top; padding: 0;">
                            <table style="width: 100%; border-collapse: separate; border-spacing: 0; border: 1px solid #E2D8C6; border-radius: 6px; font-size: 10.5px;">
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">Untaxed Amount</t>
                                    <t t-set="row_value" t-value="o.x_bd_untaxed"/>
                                </t>
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">Excise Tax</t>
                                    <t t-set="row_value" t-value="o.x_bd_excise"/>
                                </t>
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">Subtotal</t>
                                    <t t-set="row_value" t-value="o.x_bd_subtotal"/>
                                </t>
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">Other Income</t>
                                    <t t-set="row_value" t-value="o.x_bd_other_income"/>
                                </t>
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">Before VAT</t>
                                    <t t-set="row_value" t-value="o.x_bd_before_vat"/>
                                </t>
                                <t t-call="accounting_so_invoice_bridge.report_total_row">
                                    <t t-set="row_label">VAT</t>
                                    <t t-set="row_value" t-value="o.x_bd_vat"/>
                                </t>
                                <t t-if="o.x_bd_wht">
                                    <t t-call="accounting_so_invoice_bridge.report_total_row">
                                        <t t-set="row_label">Total Before WHT</t>
                                        <t t-set="row_value" t-value="o.x_bd_total_before_wht"/>
                                    </t>
                                    <t t-call="accounting_so_invoice_bridge.report_total_row">
                                        <t t-set="row_label">Withholding Tax</t>
                                        <t t-set="row_value" t-value="o.x_bd_wht"/>
                                    </t>
                                </t>
                                <tr t-attf-style="background: #{brand}; color: #ffffff; font-size: 12px; font-weight: bold;">
                                    <td style="padding: 8px 10px; border-radius: 0 0 0 5px;">Total</td>
                                    <td style="padding: 8px 10px; text-align: right; white-space: nowrap; border-radius: 0 0 5px 0;"><span t-out="o.x_bd_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </div>
        </t>
    </template>

</odoo>
