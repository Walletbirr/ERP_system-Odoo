<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Create Invoice" buttons on the Sales Order.

        New flow: the SALESPERSON creates the (draft) invoice, which
        hands the order over to Accounting. Accounting alone reviews the
        payment proof and confirms the invoice (enforced server side, see
        models/account_move.py), so showing the button to salespeople is
        safe. Visible to: Salespeople, the accountant group and Settings
        Administrators (can_create_invoice). Odoo's native Invoicing
        field is deliberately ignored.
    -->
    <record id="view_order_form_restrict_create_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.restrict.create.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='create_invoice']" position="before">
                <field name="can_create_invoice" invisible="1"/>
                <field name="x_has_submitted_payment_proof" invisible="1"/>
                <field name="x_is_credit_payment_term" invisible="1"/>
                <field name="x_payment_proof_status" invisible="1"/>
                <field name="x_invoice_unlocked" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <!-- Manual (re)send to the High-Level Manager: normally it
                     is sent automatically when Accounting approves the
                     payment proof; this covers a manager rejection. -->
                <button name="action_request_manager_approval" type="object"
                        string="Send to Manager" class="btn-primary"
                        invisible="not can_create_invoice or state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'approved' or approval_state not in ('not_required', 'rejected')"/>
            </xpath>
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="invisible">invoice_status != 'to invoice' or not can_create_invoice or not x_invoice_unlocked</attribute>
            </xpath>
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="invisible">invoice_status != 'no' or state != 'sale' or not can_create_invoice or not x_invoice_unlocked</attribute>
            </xpath>
            <!-- Invoices smart button: Accounting sees Odoo's normal invoice
                 page, salespeople a read-only page without accounting
                 detail (see sale.order.action_view_invoice). -->
            <xpath expr="//button[@name='action_view_invoice']" position="attributes">
                <attribute name="groups">sales_team.group_sale_salesman,accounting_so_invoice_bridge.group_sale_invoice_creator,base.group_system</attribute>
            </xpath>

            <!-- Status hint next to the buttons: why Create Invoice is not
                 there yet. It appears only once Accounting approved. -->
            <xpath expr="//button[@name='action_cancel']" position="after">
                <span class="alert alert-warning py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_invoice_unlocked or x_payment_proof_status not in ('none', 'pending')">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Attach the payment proof and client ID, then press Submit
                </span>
                <span class="alert alert-info py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_invoice_unlocked or x_payment_proof_status != 'submitted'">
                    <i class="fa fa-hourglass-half me-1"/>
                    Waiting for Accounting to approve the payment proof
                </span>
                <span class="alert alert-danger py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_invoice_unlocked or x_payment_proof_status != 'rejected'">
                    <i class="fa fa-times-circle me-1"/>
                    Payment proof rejected: fix it and Resubmit (see Payment Proofs tab)
                </span>
                <span class="alert alert-info py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_is_credit_payment_term or x_payment_proof_status != 'approved' or approval_state != 'to_approve'">
                    <i class="fa fa-hourglass-half me-1"/>
                    Payment approved. Waiting for the High-Level Manager to approve the order
                </span>
                <span class="alert alert-danger py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_is_credit_payment_term or x_payment_proof_status != 'approved' or approval_state != 'rejected'">
                    <i class="fa fa-times-circle me-1"/>
                    Rejected by the High-Level Manager: see the Approvals tab, then press Send to Manager again
                </span>
                <span class="alert alert-warning py-1 px-2 mb-0 ms-3 d-inline-flex align-items-center"
                      role="alert"
                      invisible="not can_create_invoice or state != 'sale' or invoice_status != 'to invoice' or x_is_credit_payment_term or x_payment_proof_status != 'approved' or approval_state != 'not_required'">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    Payment approved. Press Send to Manager to get the order approved
                </span>
            </xpath>
        </field>
    </record>

    <!--
        Payment proof tab + status stat button.

        Lifecycle of each line: Pending -> Awaiting Approval (salesperson
        presses Submit) -> Approved or Rejected (accountant). A rejected
        line goes back to the salesperson, who fixes the file and presses
        Resubmit. Salespeople edit; accountants only Approve / Reject.
        The tab is hidden for credit orders (no proof needed).
    -->
    <record id="view_order_form_payment_proof" model="ir.ui.view">
        <field name="name">sale.order.form.payment.proof</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="x_is_credit_payment_term" invisible="1"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="x_has_payment_proof" invisible="1"/>
                <field name="x_payment_proof_status" invisible="1"/>
                <button type="object" name="action_view_payment_proofs"
                        class="oe_stat_button" icon="fa-check-circle text-success"
                        groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator"
                        invisible="state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'approved'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Proof</span>
                        <span class="o_stat_text">Approved</span>
                    </div>
                </button>
                <button type="object" name="action_view_payment_proofs"
                        class="oe_stat_button" icon="fa-hourglass-half text-warning"
                        groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator"
                        invisible="state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'submitted'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Proof</span>
                        <span class="o_stat_text">Awaiting Approval</span>
                    </div>
                </button>
                <button type="object" name="action_view_payment_proofs"
                        class="oe_stat_button" icon="fa-times-circle text-danger"
                        groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator"
                        invisible="state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'rejected'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Proof</span>
                        <span class="o_stat_text">Rejected</span>
                    </div>
                </button>
                <button type="object" name="action_view_payment_proofs"
                        class="oe_stat_button" icon="fa-clock-o text-info"
                        groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator"
                        invisible="state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'pending'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Proof</span>
                        <span class="o_stat_text">Pending</span>
                    </div>
                </button>
                <button type="object" name="action_view_payment_proofs"
                        class="oe_stat_button" icon="fa-upload text-muted"
                        groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator"
                        invisible="state != 'sale' or x_is_credit_payment_term or x_payment_proof_status != 'none'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Payment Proof</span>
                        <span class="o_stat_text">Not Uploaded</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='other_information']" position="before">
                <page name="payment_proofs" string="Payment Proofs"
                      invisible="state != 'sale' or x_is_credit_payment_term"
                      groups="sales_team.group_sale_salesman,base.group_system,account.group_account_invoice,account.group_account_user,accounting_so_invoice_bridge.group_sale_invoice_creator">
                    <field name="payment_proof_editable" invisible="1"/>
                    <field name="payment_proof_ids">
                        <list editable="bottom"
                              create="parent.payment_proof_editable"
                              delete="parent.payment_proof_editable"
                              decoration-danger="state == 'rejected'"
                              decoration-success="state == 'approved'">
                            <field name="uploaded_date" readonly="1"/>
                            <field name="uploaded_by" readonly="1"/>
                            <!-- ONE column per file. Salespeople (editable) get the
                                 upload widget; accountants (read-only) get the
                                 download link. Never both, so no duplicate headers. -->
                            <field name="proof_filename" column_invisible="1"/>
                            <field name="proof_file" filename="proof_filename"
                                   string="Payment Proof"
                                   column_invisible="not parent.payment_proof_editable"
                                   readonly="state not in ('pending', 'rejected')"/>
                            <field name="download_link" widget="html" string="Payment Proof"
                                   column_invisible="parent.payment_proof_editable"/>
                            <field name="client_id_filename" column_invisible="1"/>
                            <field name="client_id_file" filename="client_id_filename"
                                   string="Client ID"
                                   column_invisible="not parent.payment_proof_editable"
                                   readonly="state not in ('pending', 'rejected')"/>
                            <field name="client_id_link" widget="html" string="Client ID"
                                   column_invisible="parent.payment_proof_editable"/>
                            <field name="preview_links" widget="html" string="Preview"
                                   column_invisible="not parent.payment_proof_editable"/>
                            <field name="notes"
                                   readonly="not parent.payment_proof_editable or state not in ('pending', 'rejected')"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'pending'"
                                   decoration-warning="state == 'submitted'"
                                   decoration-success="state == 'approved'"
                                   decoration-danger="state == 'rejected'"
                                   readonly="1"/>
                            <field name="reject_reason" readonly="1"
                                   invisible="state != 'rejected'"/>
                            <button name="action_submit" type="object"
                                    string="Submit" icon="fa-paper-plane"
                                    class="o_ab_submit_proof"
                                    invisible="not parent.payment_proof_editable or state != 'pending'"/>
                            <button name="action_submit" type="object"
                                    string="Resubmit" icon="fa-repeat"
                                    class="o_ab_submit_proof"
                                    invisible="not parent.payment_proof_editable or state != 'rejected'"/>
                            <button name="action_reopen" type="object"
                                    string="Reopen" icon="fa-undo"
                                    invisible="not parent.payment_proof_editable or state != 'submitted'"/>
                            <button name="action_open_approve_wizard" type="object"
                                    string="Approve" icon="fa-check text-success"
                                    groups="accounting_so_invoice_bridge.group_sale_invoice_creator,base.group_system"
                                    invisible="state != 'submitted'"/>
                            <button name="action_open_reject_wizard" type="object"
                                    string="Reject" icon="fa-times text-danger"
                                    groups="accounting_so_invoice_bridge.group_sale_invoice_creator,base.group_system"
                                    invisible="state != 'submitted'"/>
                        </list>
                    </field>
                    <div class="text-muted small mt-2"
                         invisible="not payment_proof_editable or x_payment_proof_status not in ('pending', 'rejected')">
                        <i class="fa fa-pencil"/> Click a line to change its files or notes. It stays
                        editable until you press Submit.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Credit sales: the salesperson's "Request Approval" button sends the
        Credit Sales Report to the High-Level Manager (customer_credit_report
        snapshot of the customer's credit), so it is labelled that way.
    -->
    <record id="view_order_form_credit_request_button" model="ir.ui.view">
        <field name="name">sale.order.form.credit.request.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_credit_approval.view_order_form_credit_approval"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_request_approval']" position="attributes">
                <attribute name="string">Send Credit Request</attribute>
                <attribute name="invisible">not requires_credit_approval or state not in ('draft', 'sent') or approval_state not in ('not_required', 'rejected')</attribute>
            </xpath>
        </field>
    </record>

    <!-- While the manager looks at the Credit Sales Report, the Sales Type
         and the note stay as they were sent. -->
    <record id="view_order_form_credit_type_locked" model="ir.ui.view">
        <field name="name">sale.order.form.credit.type.locked</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="customer_credit_report.view_order_form_customer_credit"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_header']//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent') or approval_state == 'to_approve'</attribute>
            </xpath>
            <xpath expr="//field[@name='x_credit_note']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent') or approval_state == 'to_approve'</attribute>
            </xpath>
        </field>
    </record>

</odoo>
