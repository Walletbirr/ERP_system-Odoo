<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_to_invoice_list" model="ir.ui.view">
        <field name="name">sale.order.to.invoice.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Sales Orders Ready to Invoice" create="false" edit="false">
                <field name="name" string="Order"/>
                <field name="date_order" string="Date"/>
                <field name="partner_id" string="Customer"/>
                <field name="user_id" string="Salesperson"/>
                <field name="amount_total" string="Total" sum=""/>
                <field name="currency_id"/>
                <field name="invoice_status" widget="badge"
                       decoration-success="invoice_status == 'to invoice'"/>
            </list>
        </field>
    </record>

    <!--
        Domain: confirmed orders (state = 'sale') that still have something
        left to invoice. This is a worklist, not a history log - the moment
        an order becomes fully invoiced, it drops off for good. What
        happens to the resulting invoice afterward (paid, unpaid, etc.) is
        tracked from the Invoices list itself, not here.
    -->
    <record id="action_sale_order_to_invoice" model="ir.actions.act_window">
        <field name="name">Sales Orders: To Invoice</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_order_to_invoice_list"/>
        <field name="domain">[('state', '=', 'sale'), ('invoice_status', '=', 'to invoice')]</field>
        <field name="target">current</field>
    </record>

    <!--
        Menu placed inside Invoicing/Accounting > Customers, right next to
        the normal Invoices menu, so Billing/Accountant users never need to
        leave the Accounting app. Clicking a row opens the standard Sales
        Order form (accountants already have read-only access to it), where
        the "Create Invoice" button - now restricted to the dedicated
        group_sale_invoice_creator group - does the actual work via Odoo's
        native invoicing engine.
    -->
    <menuitem id="menu_account_so_invoice_wizard"
              name="Create Invoice from Sales Order"
              parent="account.menu_finance_receivables"
              action="action_sale_order_to_invoice"
              groups="account.group_account_invoice,account.group_account_user"
              sequence="15"/>

</odoo>
