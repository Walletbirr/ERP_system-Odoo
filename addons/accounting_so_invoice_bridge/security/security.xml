<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Dedicated custom permission, completely decoupled from Odoo's
        native "Invoicing" access-rights field on the Users form.

        Why this exists: the native Invoicing field (Billing / Accountant)
        cannot always be left blank for a Sales user on every instance,
        and - more importantly - granting it hands over the ENTIRE
        Accounting/Invoicing app (create invoices from scratch, register
        payments, etc.), not just this one button. Relying on it to gate
        the Sales Order "Create Invoice" button was therefore both
        unreliable and, if it did work, still left a much bigger hole open
        elsewhere.

        This group lives in its own category, so it shows up in
        Settings > Users > Access Rights as its own independent checkbox -
        completely separate from the "Invoicing" selection field. Whether
        a user's native Invoicing field says "Billing", "Accountant", or
        is left blank has NO effect on this group or on the button.

        Only the admin assigns this manually, only to people who should
        actually be allowed to click "Create Invoice" on a Sales Order.
    -->
    <record id="module_category_sale_invoice_bridge" model="ir.module.category">
        <field name="name">Sales Order Invoicing (Custom)</field>
        <field name="description">Dedicated, decoupled permission for the Accounting side of the Sales Order invoicing flow: approve or reject payment proofs and confirm invoices created from Sales Orders. Independent of the native Invoicing/Billing field.</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_sale_invoice_creator" model="res.groups">
        <field name="name">Accountant: Approve Payment Proof &amp; Confirm Sales Invoices</field>
        <field name="category_id" ref="module_category_sale_invoice_bridge"/>
        <field name="comment">Accounting users who review the draft invoice a salesperson created from a Sales Order: they approve or reject its payment proof and are the ONLY ones (with Settings Administrators) who can confirm (post) that invoice. Salespeople create the draft invoice but can never confirm it. Intentionally separate from the native Invoicing/Billing field - assign it directly and only to real accountants.</field>
    </record>

    <!--
        Record rule: Billing / Accountant users may only ever SEE confirmed
        Sales Orders. Draft quotations and "sent" quotations stay invisible
        to them - they should never be picking/editing a quotation, only
        invoicing what Sales has already confirmed.

        NOTE: perm_read/write/create/unlink for these groups on sale.order
        and sale.order.line is set in ir.model.access.csv (read-only).
        This rule narrows WHICH records they can read, on top of that.

        This is unrelated to the button restriction above - it only
        governs what accountants can see when they browse Sales Orders
        from the Accounting app.
    -->
    <record id="rule_sale_order_accounting_confirmed_only" model="ir.rule">
        <field name="name">Accounting: Confirmed Sales Orders Only (read-only)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('state', 'not in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                    (4, ref('account.group_account_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_sale_order_line_accounting_confirmed_only" model="ir.rule">
        <field name="name">Accounting: Confirmed Sales Order Lines Only (read-only)</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.state', 'not in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                    (4, ref('account.group_account_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!--
        Payment proof record rules for Salespeople only (two, since a
        single ir.rule domain applies uniformly across whichever perm_*
        flags are set on it):

        1) READ: any proof belonging to a Sales Order this salesperson
           is the salesperson on, OR that they personally uploaded -
           regardless of its state (Pending or Submitted).

        2) WRITE/CREATE: same order/uploader scope, with NO state
           condition - there is no approval step to protect here (the
           payment already happened by the time a proof exists), so a
           salesperson can freely edit a line, Submit it, or Reopen an
           already-Submitted line themselves. The Pending/Submitted
           readonly behaviour on individual fields in the view is a UI
           convenience only, not a security boundary, by design.

        Accounting groups are NOT added to either rule - the CSV grants
        them read-only access to this model (no write/create at all),
        matching the strictly read-only rendering they get in the form
        view (see sale_order_form_views.xml).
    -->
    <record id="rule_sale_order_payment_proof_salesman_read" model="ir.rule">
        <field name="name">Payment Proof: Salesperson may read their own orders' proofs</field>
        <field name="model_id" ref="model_sale_order_payment_proof"/>
        <field name="domain_force">['|', ('sale_order_id.user_id', '=', user.id),
                                    ('uploaded_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_sale_order_payment_proof_salesman_write" model="ir.rule">
        <field name="name">Payment Proof: Salesperson may edit their own orders' proofs</field>
        <field name="model_id" ref="model_sale_order_payment_proof"/>
        <field name="domain_force">['|', ('sale_order_id.user_id', '=', user.id),
                                    ('uploaded_by', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!--
        Accounting (Billing / Accountant): unrestricted read of EVERY
        payment proof, regardless of which order it's on or who uploaded
        it - the whole point of this model is that Accounting can see
        what Sales attached before invoicing.

        This is deliberately its own separate rule (rather than relying
        on there simply being no group-scoped rule for these groups) so
        it keeps working even for a user who holds an Accounting group
        AND a Sales group at the same time (e.g. an accountant who was
        also given some Sales visibility). ir.rule combines multiple
        applicable group-rules on the same model with OR, so this
        unrestricted rule guarantees full visibility no matter what the
        Sales-scoped read rule above says for that same user - without
        it, that user would only ever see proofs on their own orders.
    -->
    <record id="rule_sale_order_payment_proof_accounting_read" model="ir.rule">
        <field name="name">Payment Proof: Accounting may read every proof</field>
        <field name="model_id" ref="model_sale_order_payment_proof"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                    (4, ref('account.group_account_user')),
                                    (4, ref('group_sale_invoice_creator'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
