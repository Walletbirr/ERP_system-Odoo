<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_manual_journal_items" model="ir.ui.view">
        <field name="name">account.move.form.manual.journal.items</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- The switch, on top of the Journal Items tab -->
            <xpath expr="//page[@name='aml_tab']/field[@name='line_ids']" position="before">
                <div class="d-flex align-items-center mb-2"
                     invisible="move_type == 'entry'">
                    <field name="manual_journal_items" readonly="state != 'draft' or not id"/>
                    <label for="manual_journal_items" class="mb-0 ms-2 fw-bold"/>
                </div>
            </xpath>

            <!-- Debit / Credit: editable on every line except sections and notes -->
            <xpath expr="//page[@name='aml_tab']//list/field[@name='debit']" position="attributes">
                <attribute name="readonly">display_type in ('line_section', 'line_note') or (parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and display_type == 'product' and not parent.manual_journal_items)</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list/field[@name='credit']" position="attributes">
                <attribute name="readonly">display_type in ('line_section', 'line_note') or (parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and display_type == 'product' and not parent.manual_journal_items)</attribute>
            </xpath>

        </field>
    </record>
</odoo>
