<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal form — no custom fields (is_vehicle etc.) -->
    <record id="view_product_template_binget_safe_form" model="ir.ui.view">
        <field name="name">product.template.binget.safe.form</field>
        <field name="model">product.template</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Product name"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="default_code"/>
                            <field name="barcode"/>
                            <field name="categ_id"/>
                            <field name="list_price"/>
                            <field name="standard_price"/>
                        </group>
                        <group string="Inventory">
                            <field name="is_storable"/>
                            <field name="tracking"/>
                            <field name="uom_id" groups="uom.group_uom"/>
                            <field name="qty_available"/>
                            <field name="virtual_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="desc">
                            <field name="description_sale" placeholder="Sales description…"/>
                            <field name="description" placeholder="Internal notes…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
