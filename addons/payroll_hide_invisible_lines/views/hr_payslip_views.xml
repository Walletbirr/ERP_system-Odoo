<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_view_form_hide_invisible_toggle" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.hide.invisible.toggle</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hide_invisible_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='hide_child_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
