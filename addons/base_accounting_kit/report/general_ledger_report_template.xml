<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_general_ledger">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="15"/>
            <t t-set="data_report_header_spacing" t-value="0"/>
            <t t-set="data_report_dpi" t-value="110"/>
            
            <!-- Custom clean layout - no default Odoo header -->
            <div class="page" style="padding-top: 5px;">
                
                <!-- FULL HEADER -->
                <div style="text-align: center; margin-bottom: 18px;">
                    <div style="font-size: 24px; font-weight: 700; letter-spacing: 0.5px; color: #111; margin-bottom: 4px;">
                        <span t-esc="env.company.name"/>
                    </div>
                    <div style="font-size: 18px; font-weight: 600; color: #222; margin-bottom: 3px;">
                        General Ledger
                    </div>
                    <div style="font-size: 14px; font-weight: 500; color: #444;">
                        <t t-if="data.get('date_to')">
                            As of <span t-esc="datetime.datetime.strptime(data['date_to'], '%Y-%m-%d').strftime('%B %Y')"/>
                        </t>
                        <t t-else="">
                            As of <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %Y')"/>
                        </t>
                    </div>
                </div>
                
                <!-- Page number footer -->
                <div class="footer" style="width: 100%; text-align: right; font-size: 10px; color: #555;">
                    <span class="page"/> / <span class="topage"/>
                </div>

                <table class="table table-sm" style="border-collapse:collapse; width:100%; font-size:11.5px;">
                    
                    <!-- TABLE HEADER -->
                    <thead>
                        <tr style="background:#d9d9d9; border:1px solid #999; font-weight:bold;">
                            <th style="padding:7px; border:1px solid #999;">Date</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['show_journal']">JRNL</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['show_partner']">Partner</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['show_ref']">Ref</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['show_move']">Move</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['show_entry_label']">Entry Label</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Debit</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Credit</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Balance</th>
                        </tr>
                    </thead>

                    <!-- BODY -->
                    <tbody>
                        <t t-foreach="Accounts" t-as="account">
                            
                            <!-- ACCOUNT HEADER -->
                            <tr style="background:#ececec; font-weight:bold; border-top:2px solid #666;">
                                <td t-att-colspan="visible_info_columns" style="padding:8px; border:1px solid #bbb;">
                                    <span t-esc="account['code']"/> - <span t-esc="account['name']"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666;">
                                    <span t-esc="'{:,.2f}'.format(account['debit'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666;">
                                    <span t-esc="'{:,.2f}'.format(account['credit'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666; font-weight:bold;">
                                    <span t-esc="'{:,.2f}'.format(account['balance'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                            </tr>

                            <!-- INITIAL BALANCE -->
                            <t t-if="data['initial_balance']">
                                <tr style="background:#f5f5f5; font-weight:bold;">
                                    <td t-att-colspan="visible_info_columns + 2" class="text-end">Initial Balance</td>
                                    <td class="text-end">
                                        <span t-esc="'{:,.2f}'.format(account['initial_balance'])"/>
                                        <span t-esc="env.company.currency_id.symbol"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- MOVE LINES -->
                            <tr t-foreach="account['move_lines']" t-as="line">
                                <td style="padding:6px; border:1px solid #ddd;">
                                    <span t-esc="line['ldate']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;" t-if="data['show_journal']">
                                    <span t-esc="line['lcode']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;" t-if="data['show_partner']">
                                    <span t-esc="line['partner_name']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;" t-if="data['show_ref']">
                                    <span t-if="line['lref']" t-esc="line['lref']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;" t-if="data['show_move']">
                                    <t t-if="report_type == 'html'">
                                        <a t-if="line.get('move_id')" t-att-href="'/web#id=%s&amp;model=account.move&amp;view_type=form' % line['move_id']" target="_blank">
                                            <span t-esc="line['move_name']"/>
                                        </a>
                                        <span t-if="not line.get('move_id')" t-esc="line['move_name']"/>
                                    </t>
                                    <t t-if="report_type != 'html'">
                                        <span t-esc="line['move_name']"/>
                                    </t>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;" t-if="data['show_entry_label']">
                                    <t t-if="report_type == 'html'">
                                        <a t-if="line.get('lid')" t-att-href="'/web#id=%s&amp;model=account.move.line&amp;view_type=form' % line['lid']" target="_blank">
                                            <span t-esc="line['lname']"/>
                                        </a>
                                        <span t-if="not line.get('lid')" t-esc="line['lname']"/>
                                    </t>
                                    <t t-if="report_type != 'html'">
                                        <span t-esc="line['lname']"/>
                                    </t>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <t t-if="report_type == 'html'">
                                        <a t-if="line.get('lid')" t-att-href="'/web#id=%s&amp;model=account.move.line&amp;view_type=form' % line['lid']" target="_blank">
                                            <span t-esc="'{:,.2f}'.format(line['debit'])"/>
                                            <span t-esc="env.company.currency_id.symbol"/>
                                        </a>
                                        <span t-if="not line.get('lid')" t-esc="'{:,.2f}'.format(line['debit'])"/>
                                        <span t-if="not line.get('lid')" t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                    <t t-if="report_type != 'html'">
                                        <span t-esc="'{:,.2f}'.format(line['debit'])"/>
                                        <span t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <t t-if="report_type == 'html'">
                                        <a t-if="line.get('lid')" t-att-href="'/web#id=%s&amp;model=account.move.line&amp;view_type=form' % line['lid']" target="_blank">
                                            <span t-esc="'{:,.2f}'.format(line['credit'])"/>
                                            <span t-esc="env.company.currency_id.symbol"/>
                                        </a>
                                        <span t-if="not line.get('lid')" t-esc="'{:,.2f}'.format(line['credit'])"/>
                                        <span t-if="not line.get('lid')" t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                    <t t-if="report_type != 'html'">
                                        <span t-esc="'{:,.2f}'.format(line['credit'])"/>
                                        <span t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <t t-if="report_type == 'html'">
                                        <a t-if="line.get('lid')" t-att-href="'/web#id=%s&amp;model=account.move.line&amp;view_type=form' % line['lid']" target="_blank">
                                            <span t-esc="'{:,.2f}'.format(line['balance'])"/>
                                            <span t-esc="env.company.currency_id.symbol"/>
                                        </a>
                                        <span t-if="not line.get('lid')" t-esc="'{:,.2f}'.format(line['balance'])"/>
                                        <span t-if="not line.get('lid')" t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                    <t t-if="report_type != 'html'">
                                        <span t-esc="'{:,.2f}'.format(line['balance'])"/>
                                        <span t-esc="env.company.currency_id.symbol"/>
                                    </t>
                                </td>
                            </tr>

                            <!-- ENDING BALANCE -->
                            <tr style="background:#f5f5f5; font-weight:bold; border-top:2px solid #999;">
                                <td t-att-colspan="visible_info_columns + 2" class="text-end" style="padding:8px; border:1px solid #bbb;">
                                    Ending Balance
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666; font-size:13px;">
                                    <span t-esc="'{:,.2f}'.format(account['ending_balance'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                            </tr>

                        </t>
                    </tbody>
                </table>

            </div>
        </t>
    </template>
</odoo>
