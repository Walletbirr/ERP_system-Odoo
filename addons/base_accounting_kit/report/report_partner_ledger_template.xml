<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_partnerledger">
        <t t-call="web.html_container">
            <t t-set="data_report_margin_top" t-value="15"/>
            <t t-set="data_report_header_spacing" t-value="0"/>
            <t t-set="data_report_dpi" t-value="110"/>
            
            <!-- Custom clean layout - no default Odoo header -->
            <div class="page" style="padding-top: 5px;">
            
                <!-- FULL HEADER -->
                <div style="text-align: center; margin-bottom: 18px;">
                    <div style="font-size: 24px; font-weight: 700; letter-spacing: 0.5px; color: #111; margin-bottom: 4px;">
                        <span t-esc="env.company.name"/>
                    </div>
                    <div style="font-size: 18px; font-weight: 600; color: #222; margin-bottom: 3px;">
                        Partner Ledger
                    </div>
                    <div style="font-size: 14px; font-weight: 500; color: #444;">
                        <t t-if="data['form'].get('date_to')">
                            As of <span t-esc="data['form']['date_to']"/>
                        </t>
                        <t t-else="">
                            As of <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %Y')"/>
                        </t>
                    </div>
                </div>
                
                <!-- Page number footer -->
                <div class="footer" style="width: 100%; text-align: right; font-size: 10px; color: #555;">
                    <span class="page"/> / <span class="topage"/>
                </div>

                <table class="table table-sm" style="border-collapse:collapse; width:100%; font-size:11.5px;">
                    <thead>
                        <tr style="background:#d9d9d9; border:1px solid #999; font-weight:bold;">
                            <th style="padding:7px; border:1px solid #999;">Date</th>
                            <th style="padding:7px; border:1px solid #999;">JRNL</th>
                            <th style="padding:7px; border:1px solid #999;">Ref</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Debit</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Credit</th>
                            <th style="padding:7px; border:1px solid #999; border-left:2px solid #666; text-align:right;">Balance</th>
                            <th style="padding:7px; border:1px solid #999;" t-if="data['form']['amount_currency']">Currency</th>
                        </tr>
                    </thead>
                    <t t-foreach="docs" t-as="o">
                        <tbody>
                            <tr style="background:#ececec; font-weight:bold; border-top:2px solid #666;">
                                <td colspan="3" style="padding:8px; border:1px solid #bbb;">
                                    <span t-esc="o.ref"/> - <span t-esc="o.name"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666;">
                                    <span t-esc="'{:,.2f}'.format(sum_partner(data, o, 'debit'))"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666;">
                                    <span t-esc="'{:,.2f}'.format(sum_partner(data, o, 'credit'))"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:8px; border:1px solid #bbb; border-left:2px solid #666;">
                                    <span t-esc="'{:,.2f}'.format(sum_partner(data, o, 'debit - credit'))"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td t-if="data['form']['amount_currency']" style="padding:8px; border:1px solid #bbb;"></td>
                            </tr>
                            <tr t-foreach="lines(data, o)" t-as="line">
                                <td style="padding:6px; border:1px solid #ddd;">
                                    <span t-esc="line['date']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;">
                                    <span t-esc="line['code']"/>
                                </td>
                                <td style="padding:6px; border:1px solid #ddd;">
                                    <span t-esc="line['displayed_name']"/>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <span t-esc="'{:,.2f}'.format(line['debit'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <span t-esc="'{:,.2f}'.format(line['credit'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd; border-left:2px solid #999;">
                                    <span t-esc="'{:,.2f}'.format(line['progress'])"/>
                                    <span t-esc="env.company.currency_id.symbol"/>
                                </td>
                                <td class="text-end" style="padding:6px; border:1px solid #ddd;" t-if="data['form']['amount_currency']">
                                    <t t-if="line['currency_id']">
                                        <span t-esc="'{:,.2f}'.format(line['amount_currency'])"/>
                                        <span t-esc="line['currency_id'].symbol"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </t>
                </table>
            </div>
        </t>
    </template>
</odoo>
