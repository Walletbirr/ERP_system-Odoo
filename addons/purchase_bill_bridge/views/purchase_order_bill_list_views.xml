<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_to_bill_list" model="ir.ui.view">
        <field name="name">purchase.order.to.bill.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchase Orders Ready to Bill" create="false" edit="false">
                <field name="name" string="Order"/>
                <field name="date_order" string="Date"/>
                <field name="partner_id" string="Vendor"/>
                <field name="user_id" string="Buyer"/>
                <field name="amount_total" string="Total" sum=""/>
                <field name="currency_id"/>
                <field name="invoice_status" widget="badge"
                       decoration-success="invoice_status == 'to invoice'"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_order_to_bill" model="ir.actions.act_window">
        <field name="name">Purchase Orders: To Bill</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_purchase_order_to_bill_list"/>
        <field name="domain">[('state', '=', 'purchase'), ('invoice_status', '=', 'to invoice')]</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_purchase_order_to_bill"
              name="Create Bill from Purchase Order"
              parent="account.menu_finance_payables"
              action="action_purchase_order_to_bill"
              groups="account.group_account_invoice,account.group_account_user"
              sequence="15"/>

</odoo>
