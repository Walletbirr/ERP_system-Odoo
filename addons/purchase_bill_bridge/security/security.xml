<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_purchase_bill_bridge" model="ir.module.category">
        <field name="name">Purchase Order Billing (Custom)</field>
        <field name="description">Dedicated, decoupled permission controlling who may click "Create Bill" on a Purchase Order. Independent of the native Invoicing/Billing field.</field>
        <field name="sequence">51</field>
    </record>

    <record id="group_purchase_bill_creator" model="res.groups">
        <field name="name">Can Create Bill from Purchase Order</field>
        <field name="category_id" ref="module_category_purchase_bill_bridge"/>
        <field name="comment">Users with this group (or Settings Administrators) are the only ones who will ever see an active "Create Bill" button on a Purchase Order. This is intentionally separate from the native Invoicing/Billing field - assign it directly and only to real accountants.</field>
    </record>

    <record id="rule_purchase_order_accounting_confirmed_only" model="ir.rule">
        <field name="name">Accounting: Confirmed Purchase Orders Only (read-only)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('state', 'not in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                    (4, ref('account.group_account_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <record id="rule_purchase_order_line_accounting_confirmed_only" model="ir.rule">
        <field name="name">Accounting: Confirmed Purchase Order Lines Only (read-only)</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">[('order_id.state', 'not in', ('draft', 'sent'))]</field>
        <field name="groups" eval="[(4, ref('account.group_account_invoice')),
                                    (4, ref('account.group_account_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
