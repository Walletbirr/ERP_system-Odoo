<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cash_sale_draft_migration_form" model="ir.ui.view">
        <field name="name">cash.sale.draft.migration.form</field>
        <field name="model">cash.sale.draft.migration</field>
        <field name="arch" type="xml">
            <form string="Convert drafts to cash sale">
                <field name="state" invisible="1"/>
                <group>
                    <field name="invoice_ids" widget="many2many_tags" readonly="state == 'done'"/>
                    <field name="payment_term_id" readonly="state == 'done'" options="{'no_create': True}"/>
                    <field name="post_after" readonly="state == 'done'"/>
                </group>
                <field name="report" invisible="not report" widget="text" nolabel="1"
                       style="font-family: monospace; white-space: pre-wrap;"/>
                <footer>
                    <button name="action_load_candidates" string="Load all old cash drafts"
                            type="object" invisible="state == 'done'"/>
                    <button name="action_check" string="Check only" type="object"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_convert" string="Convert" type="object"
                            class="btn-primary" invisible="state == 'done'"
                            confirm="Convert the selected invoices now?"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cash_sale_draft_migration" model="ir.actions.act_window">
        <field name="name">Convert drafts to cash sale</field>
        <field name="res_model">cash.sale.draft.migration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
