<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_payslip_run_form_confirm_all" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.confirm.all</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="payroll.hr_payslip_run_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm_all_payslips"
                        string="Confirm All Payslips"
                        type="object"
                        class="oe_highlight"
                        confirm="This will compute and confirm every payslip in this batch. Continue?"/>
            </xpath>
        </field>
    </record>
</odoo>
