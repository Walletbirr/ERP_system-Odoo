<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_payslip_by_employees_not_worked" model="ir.ui.view">
        <field name="name">hr.payslip.employees.form.not.worked</field>
        <field name="model">hr.payslip.employees</field>
        <field name="inherit_id" ref="payroll.view_hr_payslip_by_employees" />
        <field name="arch" type="xml">
            <!-- Keep the original employee_ids (multi-select modal) and add the detail list after it -->
            <xpath expr="//field[@name='employee_ids']" position="after">
                <separator string="Employee Details (Not Worked Days)" colspan="4" />
                <field name="line_ids" nolabel="1" colspan="4">
                    <list editable="bottom" create="0" delete="0">
                        <field name="employee_id" readonly="1" />
                        <field name="work_phone" optional="show" readonly="1" />
                        <field name="work_email" optional="show" readonly="1" />
                        <field name="department_id" optional="show" readonly="1" />
                        <field name="job_id" optional="show" readonly="1" />
                        <field name="parent_id" optional="hide" readonly="1" />
                        <field name="monthly_salary" readonly="1" />
                        <field name="not_worked_days" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
