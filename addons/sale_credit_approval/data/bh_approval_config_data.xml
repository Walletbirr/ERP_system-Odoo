<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="default_bh_approval_config" model="bh.approval.config">
        <field name="name">Sales Approval Settings</field>
    </record>


    <!-- Mobile push notifications. The secret is NOT created here: set
         bh_push.secret yourself (same value as PUSH_WEBHOOK_SECRET in the
         BFF). Without it, pushes are simply off. -->
    <record id="param_bh_push_bff_url" model="ir.config_parameter">
        <field name="key">bh_push.bff_url</field>
        <field name="value">http://localhost:4000</field>
    </record>

</odoo>
