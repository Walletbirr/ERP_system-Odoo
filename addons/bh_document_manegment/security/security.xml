<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_document_tracking" model="ir.module.category">
        <field name="name">Document Tracking</field>
        <field name="description">Access to assigning VINs and collecting vehicle documents.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_document_collector" model="res.groups">
        <field name="name">Document Collector</field>
        <field name="category_id" ref="module_category_document_tracking"/>
        <!-- Administrator is added automatically on install/upgrade so
             whoever is testing/administering the system doesn't get
             locked out. Add any other staff who should be able to
             assign VINs and mark documents collected from Settings >
             Users > (user) > this "Document Tracking" category. -->
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">
            Users in this group can assign VINs, mark vehicle documents
            as collected, and use the collection wizards.

            Everyone else (any regular user, e.g. Sales) can still see
            document status - including via the "View Units" button on
            an invoice line - but strictly read-only: no VIN assignment,
            no "Mark Collected", no collection wizards.
        </field>
    </record>

</odoo>
