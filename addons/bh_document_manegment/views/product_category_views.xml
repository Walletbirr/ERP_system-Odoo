<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_category_form_document_tracking" model="ir.ui.view">
        <field name="name">product.category.form.document.tracking</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <group string="Vehicle Document Tracking">
                    <field name="x_requires_document_tracking"/>
                    <field name="x_effective_document_tracking" readonly="1"
                           invisible="x_requires_document_tracking"
                           string="Tracking Active (Inherited from Parent)"/>
                </group>
            </field>
        </field>
    </record>

</odoo>
