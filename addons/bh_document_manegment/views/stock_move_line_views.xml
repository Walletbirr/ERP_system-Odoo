<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Detailed Operations" popup (stock.move.line list) shown while
        receiving, e.g. Purchase > Receipt > line icon. Inherits the real,
        verified core view (confirmed via Developer Mode > Edit View,
        External ID stock.view_stock_move_line_detailed_operation_tree)
        rather than a guessed ID, and anchors to the "lot_name" field,
        which is confirmed present.

        Adds the same "Serial Number" concept already used in the Sales >
        Vehicle VIN / Serial Registry list and on the Lot/Serial Number
        form (x_secondary_number on stock.lot), so it can be captured at
        the moment of receiving, right next to the VIN / Lot fields.
    -->

    <record id="view_stock_move_line_detailed_operation_tree_secondary_number" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.secondary.number</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="attributes">
                <attribute name="string">VIN</attribute>
            </xpath>
            <xpath expr="//field[@name='lot_name']" position="after">
                <field name="x_lot_secondary_number"
                       string="Serial Number"
                       column_invisible="context.get('picking_code') != 'incoming'"
                       groups="stock.group_production_lot"
                       invisible="not lots_visible"
                       readonly="state in ('done', 'cancel') and is_locked"
                       context="{'default_product_id': product_id}"/>
            </xpath>
        </field>
    </record>

</odoo>