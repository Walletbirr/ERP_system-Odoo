<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Standalone (non-inherited) list/form for stock.lot, scoped to
        vehicle categories. Kept standalone rather than injected into the
        core Lots/Serial Numbers views to avoid guessing at core view IDs.
        Includes On Hand Quantity (native product_qty field on stock.lot)
        so each unit's VIN, Serial Number, and stock status show together
        in one place.
    -->

    <record id="view_vehicle_lot_registry_list" model="ir.ui.view">
        <field name="name">stock.lot.vehicle.registry.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Vehicle VIN / Serial Registry">
                <field name="product_id" string="Vehicle"/>
                <field name="name" string="VIN"/>
                <field name="x_secondary_number"/>
                <field name="shipment_reference"/>
                <field name="product_qty" string="On Hand"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_lot_registry_form" model="ir.ui.view">
        <field name="name">stock.lot.vehicle.registry.form</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <form string="Vehicle Unit">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="name" string="VIN"/>
                        <field name="x_secondary_number"/>
                        <field name="shipment_reference"/>
                        <field name="product_qty" string="On Hand" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vehicle_lot_registry_search" model="ir.ui.view">
        <field name="name">stock.lot.vehicle.registry.search</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <search string="Vehicle VIN / Serial Registry">
                <field name="name" string="VIN"/>
                <field name="x_secondary_number"/>
                <field name="shipment_reference"/>
                <field name="product_id"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_product"
                            context="{'group_by': 'product_id'}"/>
                    <filter string="Shipment" name="group_shipment"
                            context="{'group_by': 'shipment_reference'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vehicle_lot_registry" model="ir.actions.act_window">
        <field name="name">Vehicle VIN / Serial Registry</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vehicle_lot_registry_search"/>
        <field name="domain">[('product_id.categ_id.x_effective_document_tracking', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_vehicle_lot_registry_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_vehicle_lot_registry_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_create">
                Register a new vehicle unit
            </p>
            <p>
                One row per physical vehicle: its VIN, Serial Number, and
                current On Hand quantity. For bulk entry of a whole
                shipment, use the standard Odoo Import (top-left menu,
                three-dot icon on this list) with a spreadsheet - the
                columns to map are "VIN" and "Serial Number".
            </p>
        </field>
    </record>

    <!-- Moved from Sales > Configuration to Inventory > Products, right
         next to the core "Lots/Serial Numbers" menu it complements
         (both share stock.menu_stock_inventory_control as parent,
         verified against core stock module views). -->
    <menuitem id="menu_vehicle_lot_registry"
              name="Vehicle VIN / Serial Registry"
              parent="stock.menu_stock_inventory_control"
              action="action_vehicle_lot_registry"
              groups="stock.group_production_lot"
              sequence="102"/>

</odoo>
