<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales > Orders > Voided Sales: every sales order voided with this
         module, beside Void Paper Invoices. -->
    <record id="view_sale_order_void_list" model="ir.ui.view">
        <field name="name">sale.order.void.list</field>
        <field name="model">sale.order</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Voided Sales" create="false" edit="false" delete="false">
                <field name="name" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="date_order" string="Date"/>
                <field name="user_id" string="Salesperson"/>
                <field name="x_void_reason" string="Reason"/>
                <field name="x_void_date" string="Voided On"/>
                <field name="x_void_user_id" string="Voided By" optional="show"/>
                <field name="x_void_status" string="Status" widget="badge"
                       decoration-danger="x_void_status == 'void'"/>
            </list>
        </field>
    </record>

    <record id="action_sale_order_void_list" model="ir.actions.act_window">
        <field name="name">Voided Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_sale_order_void_list"/>
        <field name="domain">[('x_is_voided', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No voided sales</p>
            <p>Open a confirmed sales order and press <b>Void Sale</b>.</p>
        </field>
    </record>

    <menuitem id="menu_sale_order_void_list"
              name="Voided Sales"
              parent="sale.sale_order_menu"
              action="action_sale_order_void_list"
              groups="sales_team.group_sale_salesman"
              sequence="41"/>
</odoo>
