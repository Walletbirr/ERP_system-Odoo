<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_void" model="ir.ui.view">
        <field name="name">account.payment.form.void</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <field name="x_is_voided" invisible="1"/>
                <widget name="web_ribbon" title="VOID" bg_color="text-bg-danger"
                        invisible="not x_is_voided"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Void Info" name="void_info" invisible="not x_is_voided">
                    <group>
                        <field name="x_void_order_id"/>
                        <field name="x_void_original_amount"/>
                        <field name="x_void_reason"/>
                        <field name="x_void_date"/>
                        <field name="x_void_user_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_void" model="ir.ui.view">
        <field name="name">account.payment.search.void</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="voided" string="Voided" domain="[('x_is_voided', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
