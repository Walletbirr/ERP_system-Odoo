<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         HR side: Employees > Configuration > Benefit Categories.
         HR creates the category and its dropdown of Values here - no
         accounting fields are shown or editable from this screen.
         ============================================================ -->

    <record id="view_hr_benefit_category_list_hr" model="ir.ui.view">
        <field name="name">hr.benefit.category.list.hr</field>
        <field name="model">hr.benefit.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_benefit_category_form_hr" model="ir.ui.view">
        <field name="name">hr.benefit.category.form.hr</field>
        <field name="model">hr.benefit.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mobile / Airtime Card"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Values" name="values">
                            <p class="text-muted">
                                The dropdown of values that can be picked for
                                this category on an employee's benefit line -
                                each category has its own list, add or remove
                                as needed. "Number" values use the amount
                                below directly. "Label" values (e.g.
                                "Unlimited") are not a number themselves, so
                                open the row and set a dated rate instead -
                                that way the value can be updated (e.g. once
                                a year, when a provider's price changes)
                                without rewriting what a past period already
                                posted. Each value has its own Frequency
                                (Monthly or Yearly), so one category can mix
                                monthly amounts and a yearly "Unlimited".
                            </p>
                            <field name="option_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="value_kind"/>
                                    <field name="frequency"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="fixed_amount"
                                           invisible="value_kind == 'string'"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name" placeholder="e.g. Full, Half, Unlimited"/>
                                        <field name="value_kind"/>
                                        <field name="frequency" widget="radio" options="{'horizontal': true}"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="fixed_amount"
                                               invisible="value_kind == 'string'"/>
                                        <field name="active" invisible="1"/>
                                    </group>
                                    <group string="Rate History"
                                           invisible="value_kind != 'string'">
                                        <field name="rate_ids" nolabel="1">
                                            <list editable="bottom">
                                                <field name="date_from"/>
                                                <field name="currency_id" column_invisible="1"/>
                                                <field name="amount"/>
                                                <field name="note"/>
                                            </list>
                                        </field>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_benefit_category_hr" model="ir.actions.act_window">
        <field name="name">Benefit Categories</field>
        <field name="res_model">hr.benefit.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hr_benefit_category_list_hr')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hr_benefit_category_form_hr')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set up a benefit category
            </p>
            <p>
                e.g. Card Allowance - give it a name and add its values
                (e.g. 100, 200, 500, Unlimited). Each value has its own
                Frequency (Monthly or Yearly). Accounting sets the
                posting accounts once for all categories under
                Accounting &gt; Employee Benefits &gt; Account Configuration.
            </p>
        </field>
    </record>

    <!-- ============================================================
         Accounting side: single Account Configuration (one debit,
         one credit, one journal for all benefit categories).
         ============================================================ -->

    <record id="view_hr_benefit_account_config_form" model="ir.ui.view">
        <field name="name">hr.benefit.account.config.form</field>
        <field name="model">hr.benefit.account.config</field>
        <field name="arch" type="xml">
            <form string="Account Configuration" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Account Configuration</h1>
                        <p class="text-muted">
                            These accounts and journal are used when posting
                            any employee benefit. Set them once; they apply
                            to every benefit category.
                        </p>
                    </div>
                    <group string="Posting Accounts">
                        <field name="debit_account_id"/>
                        <field name="credit_account_id"/>
                        <field name="journal_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_benefit_account_config" model="ir.actions.act_window">
        <field name="name">Account Configuration</field>
        <field name="res_model">hr.benefit.account.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_benefit_account_config_form"/>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <!-- Server action / helper so the menu opens the single config row -->
    <record id="action_hr_benefit_account_config_open" model="ir.actions.server">
        <field name="name">Open Account Configuration</field>
        <field name="model_id" ref="model_hr_benefit_account_config"/>
        <field name="state">code</field>
        <field name="code">
config = env['hr.benefit.account.config'].get_for_company()
action = {
    'name': 'Account Configuration',
    'type': 'ir.actions.act_window',
    'res_model': 'hr.benefit.account.config',
    'view_mode': 'form',
    'views': [(env.ref('binget_employee_benefits.view_hr_benefit_account_config_form').id, 'form')],
    'res_id': config.id,
    'target': 'current',
}
        </field>
    </record>

</odoo>
