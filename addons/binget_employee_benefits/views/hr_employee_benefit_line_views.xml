<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_benefit_line_list" model="ir.ui.view">
        <field name="name">hr.employee.benefit.line.list</field>
        <field name="model">hr.employee.benefit.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="option_id" domain="[('category_id', '=', category_id)]"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="current_amount" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_benefit_line_search" model="ir.ui.view">
        <field name="name">hr.employee.benefit.line.search</field>
        <field name="model">hr.employee.benefit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="option_id"/>
                <filter string="Number Values" name="number_kind" domain="[('option_id.value_kind','=','number')]"/>
                <filter string="Label Values" name="string_kind" domain="[('option_id.value_kind','=','string')]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Value" name="group_option" context="{'group_by': 'option_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_employee_benefit_line" model="ir.actions.act_window">
        <field name="name">Employee Benefits (All Employees)</field>
        <field name="res_model">hr.employee.benefit.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_hr_employee_benefit_line_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No employee benefits configured yet
            </p>
            <p>
                HR sets these up on each employee's own form (Benefits tab).
                This screen just lists every employee's amount together, so
                Accounting can see them all at once before computing a batch.
            </p>
        </field>
    </record>

</odoo>
