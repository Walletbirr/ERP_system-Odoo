<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lc_cancel_wizard_form" model="ir.ui.view">
        <field name="name">lc.cancel.wizard.form</field>
        <field name="model">lc.cancel.wizard</field>
        <field name="arch" type="xml">

            <form string="Cancel LC">

                <sheet>

                    <div class="alert alert-danger" role="alert">
                        <strong>Warning!</strong>
                        Cancelling this LC will reverse all related accounting entries.
                        This action cannot be undone.
                    </div>

                    <group>
                        <field name="lc_id" readonly="1"/>
                        <field name="reason"
                               placeholder="Enter cancellation reason..."/>
                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_confirm_cancel"
                        string="Confirm Cancellation"
                        type="object"
                        class="btn-danger"/>

                    <button
                        string="Discard"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_lc_open_request_wizard_form" model="ir.ui.view">
        <field name="name">lc.open.request.wizard.form</field>
        <field name="model">lc.open.request.wizard</field>
        <field name="arch" type="xml">

            <form string="Send Opening Request">

                <sheet>

                    <div class="alert alert-info" role="alert">
                        This sends a notification to the accountant you choose below, asking
                        them to review and open this LC. They'll see it on their dashboard and
                        get an activity reminder until they act on it.
                    </div>

                    <group>
                        <field name="lc_id" readonly="1"/>
                        <field name="accountant_id"/>
                        <field name="note" placeholder="Anything the accountant should know before approving..."/>
                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_send"
                        string="Send"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_lc_open_confirm_wizard_form" model="ir.ui.view">
        <field name="name">lc.open.confirm.wizard.form</field>
        <field name="model">lc.open.confirm.wizard</field>
        <field name="arch" type="xml">

            <form string="Approve &amp; Open LC">

                <sheet>

                    <div class="alert alert-info" role="alert">
                        Approving this will post the following journal entry and open the LC.
                        Review it, then approve or cancel.
                    </div>

                    <group>
                        <field name="lc_id" readonly="1"/>
                        <field name="preview_text" readonly="1" nolabel="1"/>
                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_confirm_open"
                        string="Approve &amp; Open"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_lc_settlement_payment_request_wizard_form" model="ir.ui.view">
        <field name="name">lc.settlement.payment.request.wizard.form</field>
        <field name="model">lc.settlement.payment.request.wizard</field>
        <field name="arch" type="xml">

            <form string="Send Payment Request">

                <sheet>

                    <div class="alert alert-info" role="alert">
                        This sends a notification to the accountant you choose below, asking
                        them to review and approve this payment. They'll see it on their
                        dashboard and get an activity reminder until they act on it.
                    </div>

                    <group>
                        <field name="settlement_line_id" readonly="1"/>
                        <field name="accountant_id"/>
                        <field name="note" placeholder="Anything the accountant should know before approving..."/>
                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_send"
                        string="Send"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_lc_settlement_confirm_wizard_form" model="ir.ui.view">
        <field name="name">lc.settlement.confirm.wizard.form</field>
        <field name="model">lc.settlement.confirm.wizard</field>
        <field name="arch" type="xml">

            <form string="Approve &amp; Post Payment">

                <sheet>

                    <div class="alert alert-info" role="alert">
                        Approving this will post the following journal entry. The balance is
                        calculated at the settlement rate, less the margin already paid at
                        opening. Review, then approve or cancel.
                    </div>

                    <group>
                        <field name="settlement_line_id" readonly="1"/>
                        <field name="preview_text" readonly="1" nolabel="1"/>
                    </group>

                </sheet>

                <footer>

                    <button
                        name="action_confirm_settlement"
                        string="Approve &amp; Post"
                        type="object"
                        class="btn-primary"/>

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_lc_settlement_split_wizard_form" model="ir.ui.view">
        <field name="name">lc.settlement.split.wizard.form</field>
        <field name="model">lc.settlement.split.wizard</field>
        <field name="arch" type="xml">

            <form string="Split Into Tranches">
                <sheet>
                    <field name="lc_currency_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        Split the settlement of <field name="purchase_order_id" readonly="1" nolabel="1" class="d-inline"/>
                        into as many tranches as you need, all at once. Each tranche gets its
                        own date and rate, and later its own bank fee and VAT. Whatever you
                        don't allocate stays as one more tranche.
                    </div>

                    <group>
                        <group>
                            <field name="settlement_line_id" invisible="1"/>
                            <field name="current_amount"/>
                            <field name="allocated"/>
                            <field name="remainder" decoration-danger="remainder &lt; 0"
                                   decoration-success="remainder == 0"/>
                        </group>
                        <group string="Quick Split">
                            <label for="quick_count"/>
                            <div class="o_row">
                                <field name="quick_count" nolabel="1" class="oe_inline"/>
                                <button name="action_quick_split" type="object"
                                        string="Apply" class="btn-secondary" icon="fa-magic"/>
                            </div>
                        </group>
                    </group>

                    <field name="part_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="lc_currency_id" column_invisible="1"/>
                            <field name="amount" sum="Allocated"/>
                            <field name="percent" readonly="1"/>
                            <field name="date"/>
                            <field name="rate" optional="show"/>
                        </list>
                    </field>
                </sheet>

                <footer>
                    <button name="action_confirm_split" string="Create Tranches"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>

        </field>
    </record>

</odoo>
