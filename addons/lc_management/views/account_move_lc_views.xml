<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_lc_bill" model="ir.ui.view">
        <field name="name">account.move.form.lc.bill</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Letter of Credit" name="lc_bill"
                      invisible="not x_lc_id">
                    <field name="x_is_lc_bill" invisible="1"/>
                    <group>
                        <group>
                            <field name="x_lc_id"/>
                            <field name="x_lc_settled_amount" invisible="not x_is_lc_bill"/>
                            <field name="x_lc_unsettled_amount" invisible="not x_is_lc_bill"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="x_is_lc_bill">
                        On posting, the payable is replaced by the LC's GIT account.
                        The bill is then paid by LC settlement, not by a payment.
                    </div>
                    <field name="x_lc_line_ids" readonly="1">
                        <list>
                            <field name="lc_id"/>
                            <field name="purchase_order_id"/>
                            <field name="amount_to_settle"/>
                            <field name="settlement_date"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
