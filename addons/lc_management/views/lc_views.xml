<odoo>

    <!-- ===================================================== -->
    <!-- LC LIST VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_list" model="ir.ui.view">
        <field name="name">lc.management.list</field>
        <field name="model">lc.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bank_journal_id"/>
                <field name="margin_account_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="margin_amount"/>
                <field name="remaining_amount"/>
                <field name="state"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'open'"
                       decoration-warning="state == 'utilized'"
                       decoration-success="state == 'settled'"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC KANBAN VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_kanban" model="ir.ui.view">
        <field name="name">lc.management.kanban</field>
        <field name="model">lc.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="bank_journal_id"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="expiry_date"/>
                <field name="has_draft_settlement_lines"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold text-primary"><field name="name"/></div>
                            <div class="text-muted small"><field name="bank_journal_id"/></div>
                            <div class="small mt-1"><field name="partner_id"/></div>
                            <div class="small">Amount: <field name="amount"/> <field name="currency_id"/></div>
                            <div class="small">Expiry: <field name="expiry_date"/></div>
                            <div class="small mt-1">
                                <field name="state"
                                       widget="badge"
                                       decoration-muted="state == 'draft'"
                                       decoration-info="state == 'open'"
                                       decoration-warning="state == 'utilized'"
                                       decoration-success="state == 'settled'"/>
                                <span class="badge text-bg-warning ms-1" invisible="not has_draft_settlement_lines">
                                    Awaiting Review
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC FORM VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_form" model="ir.ui.view">
        <field name="name">lc.management.form</field>
        <field name="model">lc.management</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <button name="action_request_opening"
                            string="Request LC Opening"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_open_with_confirmation"
                            string="Approve &amp; Open LC"
                            type="object"
                            class="btn-primary"
                            groups="lc_management.group_lc_accountant,account.group_account_manager"
                            invisible="state != 'pending_approval'"/>

                    <button name="action_withdraw_opening_request"
                            string="Withdraw Request"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'pending_approval'"/>

                    <button name="action_open_cancel_wizard"
                            string="Cancel LC"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('settled','cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,pending_approval,open,utilized,settled"/>

                    <div class="alert alert-info mt-2" role="alert"
                         invisible="state != 'pending_approval'">
                        <strong>Awaiting accountant approval</strong>
                        <span invisible="not opening_assigned_accountant_id">
                            - sent to <field name="opening_assigned_accountant_id" nolabel="1" readonly="1" class="d-inline"/>
                        </span>
                        <span invisible="not opening_request_date">
                            on <field name="opening_request_date" nolabel="1" readonly="1" class="d-inline"/>
                        </span>
                    </div>

                    <div class="alert alert-warning mt-2" role="alert"
                         invisible="not has_draft_settlement_lines">
                        <strong>Action needed:</strong> there are unconfirmed settlement lines waiting
                        for review - see the Settlements smart button above.
                    </div>

                    <div class="alert alert-info mt-2" role="alert"
                         invisible="not pending_account_setup_count">
                        <strong>Waiting on Accounting:</strong>
                        <field name="pending_account_setup_count" nolabel="1" readonly="1" class="d-inline"/>
                        account setup request(s) still open - see the "Account Setup Requests" tab below.
                    </div>

                    <group string="Cancellation Information" invisible="state != 'cancelled'">
                        <field name="cancel_reason" readonly="1"/>
                    </group>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_settlements"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money"
                                invisible="state == 'draft'">
                            <field name="settlement_line_count" widget="statinfo" string="Settlements"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Settled" bg_color="text-bg-success"
                            invisible="state != 'settled'"/>


                    <!-- ===================================================== -->
                    <!-- TOP INFORMATION -->
                    <!-- ===================================================== -->

                    <group>

                        <group string="LC Information">
                            <field name="name" readonly="not can_edit_lc_details"/>
                            <field name="partner_id" readonly="not can_edit_lc_details"/>
                            <field name="lc_type_id" readonly="not can_edit_lc_details"/>
                            <field name="expiry_date" readonly="not can_edit_lc_details"/>
                        </group>

                        <group string="Banking Information">
                            <field name="bank_journal_id" readonly="not can_edit_lc_details"/>
                            <field name="margin_account_id"
                                    options="{'no_create': True,
                                                'no_create_edit': True,
                                                'no_open': True}"
                                    readonly="not can_edit_lc_accounts"/>
                            <field name="currency_id" readonly="not can_edit_lc_details"/>
                            <field name="exchange_rate" readonly="state != 'draft'"/>
                        </group>

                    </group>

                    <!-- ===================================================== -->
                    <!-- AMOUNTS -->
                    <!-- ===================================================== -->

                    <group>

                        <group string="LC Amount Details">
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"
                                   readonly="not can_edit_lc_details"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="can_edit_lc_details" invisible="1"/>
                            <field name="can_edit_lc_accounts" invisible="1"/>
                            <field name="margin_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="paid_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                            <field name="remaining_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}" readonly="1"/>
                        </group>

                        <group string="Margin Release Progress">
                            <field name="margin_amount_company_currency" readonly="1"/>
                            <field name="margin_released_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            <field name="margin_remaining_to_release" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            <field name="local_currency_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                        </group>

                    </group>

                    <!-- ===================================================== -->
                    <!-- OPENING CHARGES -->
                    <!-- ===================================================== -->

                    <group>
                        <group string="LC Opening Charges">
                            <field name="opening_fee" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"
                                   readonly="not can_edit_lc_details"/>
                            <label for="opening_fee_account_id"/>
                            <div class="o_row">
                                <field name="opening_fee_account_id"
                                         options="{'no_create': True,
                                                'no_create_edit': True,
                                                'no_open': True}"
                                       readonly="not can_edit_lc_accounts"/>
                                <button name="action_request_fee_account_setup"
                                        string="Request Account Setup"
                                        type="object"
                                        class="btn-link"
                                        icon="fa-bell-o"
                                        invisible="opening_fee_account_id or state in ('open','utilized','settled','cancelled')"/>
                            </div>
                            <field name="opening_vat_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"
                                   readonly="not can_edit_lc_details"/>
                            <label for="opening_vat_account_id"/>
                            <div class="o_row">
                                <field name="opening_vat_account_id"
                                         options="{'no_create': True,
                                                    'no_create_edit': True,
                                                    'no_open': True}"
                                       readonly="not can_edit_lc_accounts"/>
                                <button name="action_request_vat_account_setup"
                                        string="Request Account Setup"
                                        type="object"
                                        class="btn-link"
                                        icon="fa-bell-o"
                                        invisible="opening_vat_account_id or state in ('open','utilized','settled','cancelled')"/>
                            </div>
                            <field name="opening_date"
                                   readonly="not can_edit_lc_details"
                                   />
                        </group>

                        <group string="FX Summary">
                            <field name="fx_gain_loss"
                                   widget="monetary"
                                   options="{'currency_field': 'company_currency_id'}"
                                   readonly="1"/>
                        </group>
                    </group>

                    <group invisible="state == 'draft'">
                        <group string="Opening Approval Trail">
                            <field name="opening_requested_by_id" readonly="1"/>
                            <field name="opening_request_date" readonly="1"/>
                            <field name="opening_assigned_accountant_id" readonly="1"/>
                            <field name="opening_approved_by_id" readonly="1"/>
                            <field name="opening_approved_date" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="not account_setup_request_ids">
                        <group string="Account Setup Approval Trail" colspan="2">
                            <field name="account_setup_request_ids" nolabel="1" colspan="2">
                                <list create="false" delete="false">
                                    <field name="account_purpose"/>
                                    <field name="requested_by_id"/>
                                    <field name="sent_date"/>
                                    <field name="assigned_accountant_id"/>
                                    <field name="completed_date"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state == 'sent'"
                                           decoration-info="state == 'viewed'"
                                           decoration-success="state == 'completed'"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- ===================================================== -->
                    <!-- NOTEBOOK: PURCHASE ORDERS / SETTLEMENT -->
                    <!-- ===================================================== -->

                    <notebook>

                        <page string="Purchase Orders">
                            <field name="purchase_ids" options="{'delete': false, 'create': false}"/>
                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>


        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC ACTION -->
    <!-- ===================================================== -->
    <record id="action_lc" model="ir.actions.act_window">
        <field name="name">Letters of Credit</field>
        <field name="res_model">lc.management</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <!-- ===================================================== -->
    <!-- LC SETTLEMENT LINES - STANDALONE LIST (ONE ROW PER PO) -->
    <!-- Shows only root lines (one per Purchase Order/shipment), with -->
    <!-- rolled-up totals across all of that PO's partial tranches. -->
    <!-- Clicking a row opens the full per-PO settlement summary form. -->
    <!-- ===================================================== -->
    <record id="view_lc_settlement_line_list" model="ir.ui.view">
        <field name="name">lc.settlement.line.list</field>
        <field name="model">lc.settlement.line</field>
        <field name="arch" type="xml">
            <list decoration-info="po_settlement_status == 'draft'" decoration-success="po_settlement_status == 'completed'">
                <field name="lc_id"/>
                <field name="purchase_order_id"/>
                <field name="shipment_id"/>
                <field name="lc_currency_id" column_invisible="1"/>
                <field name="po_total_amount" string="PO Total" options="{'currency_field': 'lc_currency_id'}"/>
                <field name="po_total_settled" string="Settled So Far" options="{'currency_field': 'lc_currency_id'}"/>
                <field name="po_remaining_to_settle" string="Remaining" options="{'currency_field': 'lc_currency_id'}"/>
                <field name="po_tranche_count" string="Tranches"/>
                <field name="po_settlement_status" widget="badge" string="Status"
                       decoration-muted="po_settlement_status == 'draft'"
                       decoration-warning="po_settlement_status == 'pending'"
                       decoration-success="po_settlement_status == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC SETTLEMENT LINE - STANDALONE FORM -->
    <!-- Doubles as: (a) the action screen for a single draft tranche -->
    <!-- (Confirm/Split buttons), and (b) once you're looking at the root -->
    <!-- line for a PO, a full settlement summary - simple if it was paid -->
    <!-- in one shot, or a detailed tranche-by-tranche breakdown if it -->
    <!-- was split into partial payments. -->
    <!-- ===================================================== -->
    <record id="view_lc_settlement_line_form" model="ir.ui.view">
        <field name="name">lc.settlement.line.form</field>
        <field name="model">lc.settlement.line</field>
        <field name="arch" type="xml">
            <form>

                <header>
                    <button name="action_request_payment"
                            string="Send Payment Request"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft' or (is_root_line and not amount_to_settle)"/>
                    <button name="action_confirm_with_preview"
                            string="Approve &amp; Post Payment"
                            type="object"
                            class="btn-primary"
                            groups="lc_management.group_lc_accountant,account.group_account_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_open_split_wizard"
                            string="Split Into Partial Payment"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft' or (is_root_line and not amount_to_settle)"/>
                    <div class="float-end">
                        <span class="text-muted me-1">PO Status:</span>
                        <field name="po_settlement_status" widget="badge" nolabel="1"
                               decoration-muted="po_settlement_status == 'draft'"
                               decoration-warning="po_settlement_status == 'pending'"
                               decoration-success="po_settlement_status == 'completed'"/>
                    </div>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed"/>
                </header>

                <sheet>

                    <field name="lc_currency_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="is_root_line" invisible="1"/>
                    <field name="po_tranche_count" invisible="1"/>

                    <!-- ===================================================== -->
                    <!-- CASE A: UNDIVIDED ROOT (po_tranche_count == 1) -->
                    <!-- Settled in one shot, no splits. No breakdown table since -->
                    <!-- there is nothing to break down - this IS the only tranche. -->
                    <!-- ===================================================== -->
                    <div invisible="not is_root_line or po_tranche_count != 1">

                        <div class="oe_title">
                            <h1>
                                <field name="purchase_order_id" readonly="1" nolabel="1"/>
                            </h1>
                            <h3 class="text-muted">
                                <field name="lc_id" readonly="1" nolabel="1"/> &#8226;
                                <field name="shipment_id" readonly="1" nolabel="1"/>
                            </h3>
                        </div>

                        <!-- This root's OWN remaining balance, if it's still draft AND unsplit -->
                        <div class="alert alert-info" role="alert" invisible="state != 'draft' or not amount_to_settle">
                            If the amount below is correct, fill in the bank's fee, VAT, and rate
                            and click <strong>Confirm Settlement</strong>. If you only want to settle
                            part of it right now, click <strong>Split Into Partial Payment</strong> instead.
                        </div>

                        <div class="alert alert-success" role="alert"
                             invisible="po_settlement_status != 'completed'">
                            This Purchase Order is fully settled.
                        </div>

                        <group>
                            <group string="Amount to Settle">
                                <field name="amount_to_settle" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                                <field name="settlement_date"/>
                                <field name="settlement_rate"/>
                            </group>
                            <group string="Bank Charges (enter as billed by the bank)">
                                <field name="settlement_fee" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"
                                       readonly="state in ('confirmed','cancelled')"/>
                                <field name="settlement_fee_account_id"/>
                                <field name="settlement_vat_amount" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                                <field name="settlement_vat_account_id"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'">
                            <group string="Result">
                                <field name="margin_released_this_line" string="Margin Released" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="fx_gain_loss_this_line" string="FX Gain/Loss" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            </group>
                            <group string="Posted Entries">
                                <field name="settlement_move_id" readonly="1"/>
                                <field name="release_move_id" readonly="1"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'">
                            <group string="Payment Approval Trail">
                                <field name="requested_by_id" readonly="1"/>
                                <field name="request_date" readonly="1"/>
                                <field name="assigned_accountant_id" readonly="1"/>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                            </group>
                        </group>

                    </div>

                    <!-- ===================================================== -->
                    <!-- CASE B: ROOT THAT HAS BEEN SPLIT (po_tranche_count > 1) -->
                    <!-- The main "how was this PO paid, in full" page: PO-wide -->
                    <!-- progress, the root's own remaining balance (editable if -->
                    <!-- still draft), and ALWAYS the full breakdown table of -->
                    <!-- every partial tranche. -->
                    <!-- ===================================================== -->
                    <div invisible="not is_root_line or po_tranche_count &lt;= 1">

                        <div class="oe_title">
                            <h1>
                                <field name="purchase_order_id" readonly="1" nolabel="1"/>
                            </h1>
                            <h3 class="text-muted">
                                <field name="lc_id" readonly="1" nolabel="1"/> &#8226;
                                <field name="shipment_id" readonly="1" nolabel="1"/>
                            </h3>
                        </div>

                        <group>
                            <group string="Settlement Progress">
                                <field name="po_total_amount" string="PO Total" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                                <field name="po_total_settled" string="Settled So Far" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                                <field name="po_remaining_to_settle" string="Remaining" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                            </group>
                            <group string="Overview">
                                <field name="po_tranche_count" string="Number of Tranches" readonly="1"/>
                            </group>
                        </group>

                        <div class="alert alert-success" role="alert"
                             invisible="po_settlement_status != 'completed'">
                            This Purchase Order is fully settled.
                        </div>

                        <!-- This root's OWN remaining balance, if it's still draft -->
                        <div class="alert alert-info" role="alert" invisible="state != 'draft' or not amount_to_settle">
                            This PO still has an unsettled balance of
                            <field name="amount_to_settle" widget="monetary"
                                   options="{'currency_field': 'lc_currency_id'}" nolabel="1"/>.
                            Fill in the bank's fee, VAT, and rate below and click
                            <strong>Confirm Settlement</strong>, or click
                            <strong>Split Into Partial Payment</strong> to settle only part of it now.
                        </div>

                        <group invisible="state != 'draft' or not amount_to_settle">
                            <group string="Bank Charges (enter as billed by the bank)">
                                <field name="settlement_fee" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                                <field name="settlement_fee_account_id"/>
                                <field name="settlement_vat_amount" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                                <field name="settlement_vat_account_id"/>
                            </group>
                        </group>

                        <separator string="Tranche-by-Tranche Breakdown (this PO)"/>
                                    <div class="o_tranche_table">
                                        <field name="all_tranche_ids" options="{'no_open': True}">
                                            <list decoration-muted="state == 'cancelled'"
                                                decoration-success="state == 'confirmed'"
                                                decoration-info="state == 'submitted'"
                                                decoration-warning="state == 'draft'">
                                                <field name="lc_currency_id" column_invisible="1"/>
                                                <field name="company_currency_id" column_invisible="1"/>
                                                <field name="amount_to_settle" string="Amount" options="{'currency_field': 'lc_currency_id'}"/>
                                                <field name="settlement_date"/>
                                                <field name="settlement_rate"/>
                                                <field name="settlement_fee" options="{'currency_field': 'company_currency_id'}"/>
                                                <field name="settlement_vat_amount" options="{'currency_field': 'company_currency_id'}"/>
                                                <field name="margin_released_this_line" string="Margin Released" options="{'currency_field': 'company_currency_id'}"/>
                                                <field name="fx_gain_loss_this_line" string="FX Gain/Loss" options="{'currency_field': 'company_currency_id'}"/>
                                                <field name="state" widget="badge"
                                                    decoration-warning="state == 'draft'"
                                                    decoration-info="state == 'submitted'"
                                                    decoration-success="state == 'confirmed'"
                                                    decoration-muted="state == 'cancelled'"/>
                                                <button name="action_open_self" type="object"
                                                        icon="fa-arrow-right" string="" class="btn-link" title="Open this tranche"/>
                                            </list>
                                        </field>
                                    </div>
                                    <style>
                                        .o_tranche_table .o_data_row .o_data_cell {
                                            pointer-events: none;
                                        }
                                        .o_tranche_table .o_data_row .o_list_button {
                                            pointer-events: auto;
                                        }
                                    </style>

                    </div>

                    <!-- ===================================================== -->
                    <!-- CASE C: A NON-ROOT TRANCHE (a split child), opened on its -->
                    <!-- own (e.g. from the embedded LC tab). Shows ONLY this -->
                    <!-- specific tranche's own data - no PO totals, no breakdown -->
                    <!-- table. -->
                    <!-- ===================================================== -->
                    <div invisible="is_root_line">

                        <div class="oe_title">
                            <h2>
                                <field name="purchase_order_id" readonly="1" nolabel="1"/>
                                <span invisible="state != 'draft'"> &#8226; Partial Payment</span>
                                <span invisible="state != 'confirmed'"> &#8226; Settled Tranche</span>
                                <span invisible="state != 'cancelled'"> &#8226; Cancelled Tranche</span>
                            </h2>
                        </div>

                        <div class="alert alert-info" role="alert" invisible="state != 'draft' or not amount_to_settle">
                            If the amount below is correct, fill in the bank's fee, VAT, and rate
                            and click <strong>Confirm Settlement</strong>. If you only want to settle
                            part of it right now, click <strong>Split Into Partial Payment</strong> instead.
                        </div>

                        <group>
                            <group string="Linked To">
                                <field name="lc_id" readonly="1"/>
                                <field name="purchase_order_id" readonly="1"/>
                                <field name="shipment_id" readonly="1"/>
                                <field name="parent_settlement_line_id" readonly="1" invisible="not parent_settlement_line_id"/>
                            </group>
                        </group>

                        <!-- DRAFT: editable amount + bank charges -->
                        <group invisible="state != 'draft' or not amount_to_settle">
                            <group string="Amount to Settle (this tranche)">
                                <field name="amount_to_settle" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                                <field name="settlement_date"/>
                                <field name="settlement_rate"/>
                            </group>
                            <group string="Bank Charges (enter as billed by the bank)">
                                <field name="settlement_fee" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                                <field name="settlement_fee_account_id"/>
                                <field name="settlement_vat_amount" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}"/>
                                <field name="settlement_vat_account_id"/>
                            </group>
                        </group>

                        <!-- CONFIRMED: this tranche's own paid amount and charges only - -->
                        <!-- no PO-level totals, no breakdown table. -->
                        <group invisible="state != 'confirmed'">
                            <group string="Amount Paid (this tranche)">
                                <field name="amount_to_settle" string="Amount Paid" widget="monetary"
                                       options="{'currency_field': 'lc_currency_id'}" readonly="1"/>
                                <field name="settlement_date" readonly="1"/>
                                <field name="settlement_rate" readonly="1"/>
                            </group>
                            <group string="Bank Charges (this tranche)">
                                <field name="settlement_fee" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="settlement_fee_account_id" readonly="1"/>
                                <field name="settlement_vat_amount" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="settlement_vat_account_id" readonly="1"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'">
                            <group string="Result (this tranche)">
                                <field name="margin_released_this_line" string="Margin Released" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                                <field name="fx_gain_loss_this_line" string="FX Gain/Loss" widget="monetary"
                                       options="{'currency_field': 'company_currency_id'}" readonly="1"/>
                            </group>
                            <group string="Posted Entries (this tranche)">
                                <field name="settlement_move_id" readonly="1"/>
                                <field name="release_move_id" readonly="1"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'">
                            <group string="Payment Approval Trail">
                                <field name="requested_by_id" readonly="1"/>
                                <field name="request_date" readonly="1"/>
                                <field name="assigned_accountant_id" readonly="1"/>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                            </group>
                        </group>

                    </div>



                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC SETTLEMENT LINE - SEARCH VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_settlement_line_search" model="ir.ui.view">
        <field name="name">lc.settlement.line.search</field>
        <field name="model">lc.settlement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="lc_id"/>
                <field name="purchase_order_id"/>
                <field name="shipment_id"/>
                <filter string="Draft" name="status_draft" domain="[('po_settlement_status', '=', 'draft')]"/>
                <filter string="Pending" name="status_pending" domain="[('po_settlement_status', '=', 'pending')]"/>
                <filter string="Completed" name="status_completed" domain="[('po_settlement_status', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Letter of Credit" name="group_lc" context="{'group_by': 'lc_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lc_settlement_line" model="ir.actions.act_window">
        <field name="name">All LC Settlements</field>
        <field name="res_model">lc.settlement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_root_line', '=', True)]</field>
        <field name="context">{'create': False}</field>
        <field name="search_view_id" ref="view_lc_settlement_line_search"/>
    </record>

    <!-- ===================================================== -->
    <!-- LC TYPE LIST VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_margin_list" model="ir.ui.view">
        <field name="name">lc.margin.list</field>
        <field name="model">lc.margin</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="margin_percentage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC MARGIN FORM VIEW -->
    <!-- ===================================================== -->
    <record id="view_lc_margin_form" model="ir.ui.view">
        <field name="name">lc.margin.form</field>
        <field name="model">lc.margin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="margin_percentage"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC MARGIN ACTION -->
    <!-- ===================================================== -->
    <record id="action_lc_margin" model="ir.actions.act_window">
        <field name="name">LC Margin</field>
        <field name="res_model">lc.margin</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================================================== -->
    <!-- ROOT MENU -->
    <!-- ===================================================== -->
    <menuitem id="menu_lc_root" name="LC Management"/>

    <!-- ===================================================== -->
    <!-- LC MENU -->
    <!-- ===================================================== -->
    <menuitem id="menu_lc"
              name="Letters of Credit"
              parent="menu_lc_root"
              action="action_lc"/>

    <!-- ===================================================== -->
    <!-- LC SETTLEMENT REVIEW MENU -->
    <!-- ===================================================== -->
    <menuitem id="menu_lc_settlement_review"
              name="All Settlements"
              parent="menu_lc_root"
              action="action_lc_settlement_line"/>

    <!-- ===================================================== -->
    <!-- LC TYPE MENU -->
    <!-- ===================================================== -->
    <menuitem id="menu_lc_margin"
              name="LC Margin"
              parent="menu_lc_root"
              action="action_lc_margin"/>

    <!-- ===================================================== -->
    <!-- PURCHASE ORDER INHERIT -->
    <!-- ===================================================== -->
    <record id="purchase_order_lc_inherit" model="ir.ui.view">
        <field name="name">purchase.order.lc</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lc_id"
                       options="{'no_create': True, 'no_create_edit': True}"
                       invisible="not is_import"
                       required="is_import"
                       readonly="state in ('purchase','done')"/>
            </xpath>
        </field>
    </record>

</odoo>
