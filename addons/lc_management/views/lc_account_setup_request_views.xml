<odoo>

    <!-- ===================================================== -->
    <!-- LC ACCOUNT SETUP REQUEST - LIST -->
    <!-- ===================================================== -->
    <record id="view_lc_account_setup_request_list" model="ir.ui.view">
        <field name="name">lc.account.setup.request.list</field>
        <field name="model">lc.account.setup.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'sent'"
                  decoration-info="state == 'viewed'"
                  decoration-success="state == 'completed'">
                <field name="lc_id"/>
                <field name="account_purpose"/>
                <field name="requested_by_id"/>
                <field name="assigned_accountant_id"/>
                <field name="sent_date"/>
                <field name="viewed_date"/>
                <field name="completed_date"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'sent'"
                       decoration-info="state == 'viewed'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC ACCOUNT SETUP REQUEST - FORM -->
    <!-- ===================================================== -->
    <record id="view_lc_account_setup_request_form" model="ir.ui.view">
        <field name="name">lc.account.setup.request.form</field>
        <field name="model">lc.account.setup.request</field>
        <field name="arch" type="xml">
            <form string="Request Account Setup">
                <header invisible="not id">
                    <button name="action_mark_completed" string="Mark Account Created"
                            type="object" class="btn-primary"
                            invisible="state == 'completed' or not can_mark_completed"/>
                    <field name="state" widget="statusbar" statusbar_visible="sent,viewed,completed"/>
                    <field name="can_mark_completed" invisible="1"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="id">
                        This sends a notification to the accountant you choose below, asking
                        them to set up this account. They'll see it on their dashboard and get
                        an activity reminder until they mark it done.
                    </div>
                    <div class="oe_title">
                        <h1><field name="lc_id" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group string="What's Needed">
                            <field name="account_purpose"/>
                            <field name="suggested_account_name" placeholder="e.g. LC Opening Fee - Import"/>
                            <field name="note" placeholder="Anything the accountant should know..."/>
                        </group>
                        <group string="Send To">
                            <field name="requested_by_id" readonly="1"/>
                            <field name="assigned_accountant_id"/>
                        </group>
                    </group>
                    <group string="Timeline" invisible="not id">
                        <group>
                            <field name="sent_date" readonly="1"/>
                            <field name="viewed_date" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="response_time_hours" readonly="1"/>
                            <field name="resolution_time_hours" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer invisible="id">
                    <button name="action_close" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
                <chatter invisible="not id"/>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- LC ACCOUNT SETUP REQUEST - SEARCH -->
    <!-- ===================================================== -->
    <record id="view_lc_account_setup_request_search" model="ir.ui.view">
        <field name="name">lc.account.setup.request.search</field>
        <field name="model">lc.account.setup.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="lc_id"/>
                <field name="assigned_accountant_id"/>
                <filter string="Sent" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Viewed" name="filter_viewed" domain="[('state', '=', 'viewed')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <filter string="My Requests" name="filter_mine" domain="[('assigned_accountant_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Accountant" name="group_accountant" context="{'group_by': 'assigned_accountant_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lc_account_setup_request" model="ir.actions.act_window">
        <field name="name">Account Setup Requests</field>
        <field name="res_model">lc.account.setup.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lc_account_setup_request_search"/>
        <field name="context">{'search_default_filter_mine': 0}</field>
    </record>

    <menuitem id="menu_lc_account_setup_request"
              name="Account Setup Requests"
              parent="menu_lc_root"
              action="action_lc_account_setup_request"/>

</odoo>
